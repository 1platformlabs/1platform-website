# 1platform.pro — landing serving contract.
#
# This file is versioned here and published WITH the release, so a rollback
# restores the serving behaviour together with the content. It is never edited
# by hand on the host.
#
# The contract below was reconstructed by MEASURING the old origin
# (65.109.101.46), because that box has no SSH and its .htaccess could not be
# read. See epics/1platform-cpanel-migration/stories/PCM-03-*.md.
#
# ── HARD RULE ────────────────────────────────────────────────────────────────
# Nothing here may force HTTPS **on the same host**. The Cloudflare zone is in
# `flexible` mode — the edge connects to this origin over plain HTTP — so a
# same-host https redirect never terminates: the browser comes back to the edge
# over HTTPS, the edge still speaks HTTP to this origin, the request is
# indistinguishable from the first one, and the same rule fires again. That is an
# infinite loop, not a hardening measure.
#
# There is also nothing left for this file to harden. Cloudflare's own "Always
# Use HTTPS" already does the scheme upgrade at the edge — measured 2026-07-29:
# `http://1platform.pro/` answers 301 → `https://1platform.pro/` with
# `server: cloudflare`, before any request reaches here.
#
# A redirect that changes the HOST is a different thing and IS allowed: the
# second request carries a different Host, so it no longer matches the condition
# that produced it. See the www → apex rule immediately below. assemble.sh
# enforces exactly this distinction and fails the build on the same-host form.

Options -Indexes +FollowSymLinks

# The docroot is a symlink to the active release; the release tree contains no
# symlinks of its own. FollowSymLinks (verified served on this host) is what
# makes the atomic swap work.

# ── Canonical host: www → apex, 301 ──────────────────────────────────────────
# `www.1platform.pro` and `1platform.pro` are the same vhost on this account, so
# every page was published twice with nothing canonicalising at the HTTP layer.
# Measured 2026-07-29, before this rule: both hostnames answered 200 with
# IDENTICAL bodies (63,119 bytes) and the same <title>, both from LiteSpeed on
# the cPanel origin 66.29.132.45. The site's canonical URLs, its sitemap and its
# hreflang set are all apex + HTTPS, so www must 301 to apex.
#
# `%{REQUEST_URI}` carries the path; the query string is re-appended by
# mod_rewrite on its own, because the substitution contains no `?`.
#
# This does not violate the hard rule above — it changes the host, so the
# redirected request stops matching RewriteCond and gets served. The rule is not
# a guess: the identical block is already live on this same hosting (bowerfans.com
# PROD, and both docroots of the QA account), where the www names answer 301 and
# the apex names they point at still answer 200 with their own content.
#
# `www/pricing` (no trailing slash) costs two hops — this rule and DirectorySlash
# below, in whichever order the server runs them; both orders end on
# `https://1platform.pro/pricing/`. Every link the site emits already carries the
# trailing slash, so real traffic takes one hop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Spanish slugs: 301 from the English-slugged address ──────────────────────
# The Spanish tree used to publish English slugs — `/es/solutions/deliveries/`,
# `/es/blog/launch-online-store-30-minutes/`. It now publishes Spanish ones, and
# every old address answers a real 301 here.
#
# A real 301 rather than only the redirect stub Astro emits at each old path:
# the stub is a `<meta http-equiv="refresh">`, which Google treats as a weaker,
# slower signal than a 301 and which no non-browser client follows at all. The
# stub stays as the fallback — if a rule below ever fails to match, the reader
# still lands on the right page instead of a 404 — but it is not the contract.
#
# These are MOVES, not retirements: same page, new address. That is why the
# target is the translated page itself and never a section index.
#
# mod_alias runs in the URL-translation phase, so it wins over the stub file
# sitting at the same path. Each pattern is anchored at both ends: an unanchored
# `Redirect /es/solutions/` would also swallow paths that were never moved.
#
# Generated from `src/i18n/ES_PATHS`; `tests/htaccess-301.spec.ts` fails if the
# two ever disagree. Nothing here changes scheme or host, so the three
# `assemble.sh` guards do not apply.
<IfModule mod_alias.c>
  RedirectMatch 301 "^/es/about/$" /es/nosotros/
  RedirectMatch 301 "^/es/contact/$" /es/contacto/
  RedirectMatch 301 "^/es/pricing/$" /es/precios/
  RedirectMatch 301 "^/es/privacy/$" /es/privacidad/
  RedirectMatch 301 "^/es/terms/$" /es/terminos/
  RedirectMatch 301 "^/es/changelog/$" /es/novedades/
  RedirectMatch 301 "^/es/for-agencies/$" /es/para-agencias/
  RedirectMatch 301 "^/es/for-developers/$" /es/para-desarrolladores/
  RedirectMatch 301 "^/es/payments-invoicing/$" /es/pagos-y-facturacion/
  RedirectMatch 301 "^/es/solutions/$" /es/soluciones/
  RedirectMatch 301 "^/es/solutions/online-store/$" /es/soluciones/tienda-online/
  RedirectMatch 301 "^/es/solutions/deliveries/$" /es/soluciones/envios/
  RedirectMatch 301 "^/es/solutions/ads/$" /es/soluciones/publicidad/
  RedirectMatch 301 "^/es/solutions/whitelabel/$" /es/soluciones/marca-blanca/
  RedirectMatch 301 "^/es/solutions/content/$" /es/soluciones/sitio-web-y-contenido/
  RedirectMatch 301 "^/es/blog/1platform-vs-custom-toolchain/$" /es/blog/1platform-vs-herramientas-seo-propias/
  RedirectMatch 301 "^/es/blog/ai-content-best-practices/$" /es/blog/contenido-con-ia-buenas-practicas-seo/
  RedirectMatch 301 "^/es/blog/automate-seo-pipeline/$" /es/blog/automatizar-el-pipeline-de-seo/
  RedirectMatch 301 "^/es/blog/electronic-invoicing-online-business/$" /es/blog/facturacion-electronica-para-negocios-online/
  RedirectMatch 301 "^/es/blog/getting-started-5-minutes/$" /es/blog/primeros-pasos-en-5-minutos/
  RedirectMatch 301 "^/es/blog/integrating-payments-into-your-saas/$" /es/blog/integrar-pagos-en-tu-saas/
  RedirectMatch 301 "^/es/blog/launch-online-store-30-minutes/$" /es/blog/lanzar-una-tienda-online-en-30-minutos/
  RedirectMatch 301 "^/es/blog/programmatic-link-building/$" /es/blog/link-building-programatico/
</IfModule>

DirectoryIndex index.html

# Astro builds with trailingSlash:'always', so /pricing must 301 to /pricing/.
# On the old origin that redirect came from Apache's DirectorySlash, not from
# the app — the canonical URLs, the sitemap and every indexed link depend on it.
DirectorySlash On

# A missing page is a REAL 404. Deliberately no SPA-style fallback: a fallback
# would turn every dead URL into a soft 200 and poison the index.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Astro emits content-hashed assets under /_astro/ — safe to pin for a year.
  <FilesMatch "^.*$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>

  # Everything the build fingerprints. The name changes when the bytes change,
  # so an immutable cache can never serve a stale one.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_astro/" IMMUTABLE_ASSET=1
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET

  # Un-fingerprinted static files live in public/ (fonts, favicon, og images).
  # Their names are stable, so a year-long immutable cache would strand a fix in
  # browsers we cannot purge. A day, revalidated, is the honest ceiling.
  <FilesMatch "\.(woff2|ico|png|jpg|jpeg|webp|avif|svg)$">
    Header setifempty Cache-Control "public, max-age=86400"
  </FilesMatch>

  # HTML, feeds and the sitemap must revalidate or a deploy is invisible.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
