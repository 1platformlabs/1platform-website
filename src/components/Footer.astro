---
import Logo from '@components/Logo.astro';
import { useI18n } from '@i18n';

const { t, l } = useI18n(Astro.url.pathname);
type Column = { key: string; title: string; links: { label: string; href: string }[] };

const columns: Column[] = [
  {
    key: 'product', title: t('footer.col.product'), links: [
      { label: t('nav.solutions.onlineStore'), href: l('/solutions/online-store/') },
      { label: t('nav.solutions.website'), href: l('/solutions/website/') },
      { label: t('nav.solutions.content'), href: l('/solutions/content/') },
      { label: t('nav.solutions.deliveries'), href: l('/solutions/deliveries/') },
      { label: t('nav.solutions.ads'), href: l('/solutions/ads/') },
      { label: t('nav.solutions.whitelabel'), href: l('/solutions/whitelabel/') },
      { label: t('nav.solutions.payments'), href: l('/payments-invoicing/') },
      { label: t('footer.link.allSolutions'), href: l('/solutions/') },
    ],
  },
  {
    key: 'company', title: t('footer.col.company'), links: [
      { label: t('footer.link.about'), href: l('/about/') },
      { label: t('nav.pricing'), href: l('/pricing/') },
      { label: t('footer.link.forAgencies'), href: l('/for-agencies/') },
      { label: t('footer.link.forDevelopers'), href: l('/for-developers/') },
      { label: t('nav.blog'), href: l('/blog/') },
    ],
  },
  {
    key: 'resources', title: t('footer.col.resources'), links: [
      { label: t('footer.link.documentation'), href: 'https://developer.1platform.pro/' },
      { label: t('footer.link.apiReference'), href: 'https://developer.1platform.pro/api-docs' },
      { label: t('footer.link.codeExamples'), href: 'https://developer.1platform.pro/' },
      { label: t('footer.link.changelog'), href: l('/changelog/') },
    ],
  },
];

const legal = [
  { label: t('footer.link.terms'), href: l('/terms/') },
  { label: t('footer.link.privacy'), href: l('/privacy/') },
  { label: t('footer.link.cookiePreferences'), href: l('/cookies/') },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__intro">
      <Logo class="site-footer__logo" />
      <p>{t('footer.cta.body')}</p>
      <a class="btn btn--footer" href="https://app.1platform.pro/app/">{t('cta.getStarted')}</a>
    </div>

    <div class="site-footer__content">
      {/* The newsletter capture that used to sit here opened a `mailto:` to the
          public sales address on submit, so anything that filled it in — a bot
          included — produced a message aimed at that inbox. It was removed
          rather than hardened: a dedicated contact landing is coming, and until
          it exists the footer offers no form at all. */}
      <div class="footer-cols">
        {columns.map((column) => (
          <details class="footer-col" open data-footer-col>
            <summary><span>{column.title}</span><span class="footer-col__plus" aria-hidden="true"></span></summary>
            <ul>
              {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </details>
        ))}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>{t('footer.copyright', { year })}</p>
      <ul>{legal.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<script>
  function wireFooter() {
    const folded = globalThis.matchMedia('(max-width: 720px)').matches;
    document.querySelectorAll<HTMLDetailsElement>('[data-footer-col]').forEach((column) => { column.open = !folded; });
  }
  document.addEventListener('astro:page-load', wireFooter);
</script>

<style>
  .site-footer { margin-top: var(--space-20); background: var(--color-footer); color: var(--color-footer-text); overflow: hidden; }
  .site-footer__inner { width: min(var(--max-width), 100%); margin: 0 auto; padding: var(--space-16) var(--space-6) var(--space-6); }
  .site-footer__intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.7fr) auto; align-items: center; gap: var(--space-8); padding-bottom: var(--space-12); border-bottom: 1px solid var(--color-footer-line); }
  .site-footer :global(.site-footer__logo) { font-size: var(--text-2xl); color: var(--color-footer-text); }
  .site-footer :global(.site-footer__logo .logo__mark) { background: var(--cobalt-bright); }
  .site-footer :global(.site-footer__logo .logo__text) { color: var(--color-footer-text); }
  .site-footer__intro p { max-width: 35rem; color: var(--color-footer-muted); }
  .btn--footer { background: var(--cobalt-bright); color: var(--ink); border-color: var(--cobalt-bright); }
  /* One column now that the signup is gone. Left as `1fr 2fr` it kept an empty
     cell and squeezed the link columns into the right-hand two thirds. */
  .site-footer__content { display: grid; gap: var(--space-12); padding-block: var(--space-12); }
  .footer-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .footer-col summary { display: flex; align-items: center; justify-content: space-between; min-height: 32px; list-style: none; color: var(--color-footer-text); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; cursor: default; }
  .footer-col summary::-webkit-details-marker { display: none; }
  .footer-col ul { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .footer-col a, .site-footer__bottom a { color: var(--color-footer-muted); font-size: var(--text-sm); }
  .footer-col a:hover, .footer-col a:focus-visible, .site-footer__bottom a:hover { color: var(--color-footer-text); }
  .site-footer__bottom { display: flex; justify-content: space-between; align-items: center; gap: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-footer-line); }
  .site-footer__bottom p { color: var(--color-footer-muted); font-size: var(--text-xs); }
  .site-footer__bottom ul { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  @media (prefers-reduced-motion: no-preference) { .footer-col a, .site-footer__bottom a, .btn--footer { transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease; } }
  @media (max-width: 820px) { .site-footer__intro, .site-footer__content { grid-template-columns: 1fr; } .site-footer__intro { align-items: start; } .footer-cols { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .site-footer { margin-top: var(--space-12); } .site-footer__inner { padding-top: var(--space-12); } .site-footer__intro { gap: var(--space-5); } .site-footer__intro .btn { width: 100%; } .footer-cols { grid-template-columns: 1fr; gap: 0; } .footer-col { border-top: 1px solid var(--color-footer-line); } .footer-col:last-child { border-bottom: 1px solid var(--color-footer-line); } .footer-col summary { min-height: 54px; cursor: pointer; } .footer-col__plus { position: relative; width: 12px; height: 12px; } .footer-col__plus::before, .footer-col__plus::after { content: ''; position: absolute; top: 5px; left: 0; width: 12px; height: 1px; background: currentColor; } .footer-col__plus::after { transform: rotate(90deg); } .footer-col[open] .footer-col__plus::after { transform: rotate(0); } .footer-col ul { margin: 0 0 var(--space-5); } .site-footer__bottom { align-items: flex-start; flex-direction: column; } }
</style>
