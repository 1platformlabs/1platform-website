---
import { useI18n } from '@i18n';
const { t, l } = useI18n(Astro.url.pathname, Astro.locals);

/**
 * The wordmark, drawn from the tenant's own brand.
 *
 * The tenant's explicit mark is set as a node: a rounded square in its accent,
 * the same shape the interconnect schematic uses for a capability. The wordmark
 * and the motif are the same drawing at two scales.
 *
 * ⚠️ This file used to paint `1` and `Platform` as two literals, and Header AND
 * Footer both mount it — so on a client's domain every page carried the
 * platform's name. That is not an aesthetic detail: it is the acceptance
 * criterion of this epic (cero marca de plataforma en el HTML del inquilino)
 * failing on the chrome before anyone looked at the content.
 *
 * Mark and wordmark are separate manifest fields. This component must not infer
 * their relationship from `brand_name`: `C` + `Clínica Delta` is a valid lockup,
 * while cutting the name would produce the broken `C` + `línica Delta`. A tenant
 * without a mark degrades to the complete wordmark with no empty box.
 */
interface Props {
  /** Accessible label for the logo link. */
  label?: string;
  /** Additional CSS class for the link. */
  class?: string;
}

const { label, class: className } = Astro.props;
const tenant = Astro.locals.tenant;
const translatedLabel = t('layout.logoLabel');
// Keep tenant #1's historical, localised label byte-for-byte. A tenant whose
// catalogue accidentally carries somebody else's label still gets its own
// complete name instead of leaking that copy into the accessible surface.
const accessibleLabel =
  label ?? (translatedLabel.includes(tenant.brand_name) ? translatedLabel : tenant.brand_name);
const mark = tenant.brand_mark?.trim() || null;
const wordmark = tenant.brand_wordmark?.trim() || tenant.brand_name;
const wordmarkStyle = tenant.theme.display_font === 'instrument-serif'
  ? 'font-weight:400'
  : undefined;
const homeHref = tenant.pages.includes('/') ? l('/') : null;
---

{homeHref ? (
  <a
    href={homeHref}
    class:list={['logo', className]}
    aria-label={accessibleLabel}
    style={wordmarkStyle}
  >
    {mark && <span class="logo__mark" aria-hidden="true">{mark}</span>}<span class="logo__text">{wordmark}</span>
  </a>
) : (
  <span
    class:list={['logo', className]}
    role="img"
    aria-label={tenant.brand_name}
    style={wordmarkStyle}
  >
    {mark && <span class="logo__mark" aria-hidden="true">{mark}</span>}<span class="logo__text" aria-hidden="true">{wordmark}</span>
  </span>
)}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.36em;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.32em;
    height: 1.32em;
    border-radius: 0.26em;
    background: var(--cobalt);
    color: var(--surface);
    font-size: 0.82em;
    line-height: 1;
    /* Optical centring: the numeral's flag sits left of its own box. */
    padding-right: 0.04em;
  }

  .logo__text {
    color: var(--color-text);
  }
</style>
