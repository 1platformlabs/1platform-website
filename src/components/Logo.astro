---import { useI18n } from '@i18n';
const { t, l } = useI18n(Astro.url.pathname, Astro.locals);


/**
 * The wordmark, drawn from the tenant's own brand.
 *
 * The first character is set as a node: a rounded square in the tenant's accent,
 * the same shape the interconnect schematic uses for a capability. The wordmark
 * and the motif are the same drawing at two scales.
 *
 * ⚠️ This file used to paint `1` and `Platform` as two literals, and Header AND
 * Footer both mount it — so on a client's domain every page carried the
 * platform's name. That is not an aesthetic detail: it is the acceptance
 * criterion of this epic (cero marca de plataforma en el HTML del inquilino)
 * failing on the chrome before anyone looked at the content.
 *
 * The split is by CHARACTER rather than by a stored pair, because a brand is one
 * string and asking an operator to type it twice invites the two halves to
 * disagree. A single-character brand degrades correctly: the mark is that
 * character and the text is empty.
 */
interface Props {
  /** Accessible label for the logo link. */
  label?: string;
  /** Additional CSS class for the link. */
  class?: string;
}

const { label, class: className } = Astro.props;
const accessibleLabel = label ?? t('layout.logoLabel');

const tenant = Astro.locals.tenant;
const wordmark = tenant.brand_mark ?? tenant.brand_name;
const mark = wordmark.slice(0, 1);
const rest = wordmark.slice(1);
---

<a href={l('/')} class:list={['logo', className]} aria-label={accessibleLabel}>
  <span class="logo__mark" aria-hidden="true">{mark}</span><span class="logo__text">{rest}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.36em;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.32em;
    height: 1.32em;
    border-radius: 0.26em;
    background: var(--cobalt);
    color: var(--surface);
    font-size: 0.82em;
    line-height: 1;
    /* Optical centring: the numeral's flag sits left of its own box. */
    padding-right: 0.04em;
  }

  .logo__text {
    color: var(--color-text);
  }
</style>
