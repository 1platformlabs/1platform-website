---import { useI18n } from '@i18n';
const { t, l } = useI18n(Astro.url.pathname, Astro.locals);


/**
 * The wordmark, drawn from the tenant's own brand.
 *
 * The first character is set as a node — a rounded square in the tenant's
 * accent, the same shape the interconnect schematic uses for a capability —
 * but ONLY when that character is a digit. `1Platform`'s `1` is a numeral
 * doing the work of a glyph, not the initial of a word; boxing it and running
 * the rest as text is a deliberate motif for that one brand. Applying the same
 * cut to a brand that starts with a letter does not draw a motif, it cuts a
 * word in half — measured on the clinic tenant, `Clínica Delta` render as a
 * boxed "C" and the text "línica Delta" on every page (issue #92). So a
 * letter-led wordmark gets no box at all: the mark is empty and the full name
 * runs as text.
 *
 * ⚠️ This file used to paint `1` and `Platform` as two literals, and Header AND
 * Footer both mount it — so on a client's domain every page carried the
 * platform's name. That is not an aesthetic detail: it is the acceptance
 * criterion of this epic (cero marca de plataforma en el HTML del inquilino)
 * failing on the chrome before anyone looked at the content.
 */
interface Props {
  /** Accessible label for the logo link. */
  label?: string;
  /** Additional CSS class for the link. */
  class?: string;
}

const { label, class: className } = Astro.props;
const accessibleLabel = label ?? t('layout.logoLabel');

const tenant = Astro.locals.tenant;
const wordmark = tenant.brand_mark ?? tenant.brand_name;
// A leading digit reads as a glyph (1Platform's "1"); a leading letter is the
// start of a word, and chopping it off breaks the word instead of drawing a
// motif — see the comment above.
const boxesLeadingGlyph = /^[0-9]/.test(wordmark);
const mark = boxesLeadingGlyph ? wordmark.slice(0, 1) : '';
const rest = boxesLeadingGlyph ? wordmark.slice(1) : wordmark;
---

<a href={l('/')} class:list={['logo', className]} aria-label={accessibleLabel}>
  {mark && <span class="logo__mark" aria-hidden="true">{mark}</span>}<span class="logo__text">{rest}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.36em;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.32em;
    height: 1.32em;
    border-radius: 0.26em;
    background: var(--color-accent);
    color: var(--surface);
    font-size: 0.82em;
    line-height: 1;
    /* Optical centring: the numeral's flag sits left of its own box. */
    padding-right: 0.04em;
  }

  .logo__text {
    color: var(--color-text);
  }
</style>
