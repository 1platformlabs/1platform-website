---
import { useI18n } from '@i18n';
import { i18nKey } from '@i18n/key';
import { docsUrl } from '@lib/site-destinations';
const { t } = useI18n(Astro.url.pathname, Astro.locals);
const prefix = i18nKey('infrastructure.mcp.');
const copy = (key: string) => t(`${prefix}${key}`).replaceAll('{brand}', Astro.locals.tenant.brand_name);
const documentationHref = docsUrl(Astro.locals, '/docs/saas/1platform-api/getting-started/');
const mcpHref = docsUrl(Astro.locals, '/docs/saas/1platform-api/integrar-con-ia#mcp');
---
<section class="section mcp-section" id="mcp" aria-labelledby="mcp-title">
        <div class="wrap mcp-layout">
          <div class="mcp-copy">
            <p class="eyebrow">{copy("eyebrow")}</p>
            <h2 id="mcp-title">{copy("title")}</h2>
            <p>{copy("description")}</p>
            <p class="mcp-definition">{copy("definition")}</p>
            {mcpHref && <a class="button button--navy" href={mcpHref}>{copy("cta")}<svg class="icon" aria-hidden="true"><use href="#infra-i-up" /></svg></a>}
            {documentationHref && <a class="text-link" href={documentationHref}>{copy("docs")}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>}
          </div>
          <div class="mcp-preview" aria-label={copy("exampleLabel")}>
            <div class="mcp-preview-top"><span>{copy("previewTitle")}</span><span class="mcp-example-label">{copy("example")}</span></div>
            <blockquote>{copy("prompt")}</blockquote>
            <div class="mcp-route" aria-label={copy("routeLabel")}><span>{copy("assistant")}</span><span class="mcp-route-bridge">MCP</span><strong>{Astro.locals.tenant.brand_name}</strong></div>
            <ul class="mcp-context">
              <li><svg class="icon" aria-hidden="true"><use href="#infra-i-check" /></svg><div><strong>{copy("docsTitle")}</strong><span>{copy("docsBody")}</span></div></li>
              <li><svg class="icon" aria-hidden="true"><use href="#infra-i-check" /></svg><div><strong>{copy("startTitle")}</strong><span>{copy("startBody")}</span></div></li>
              <li><svg class="icon" aria-hidden="true"><use href="#infra-i-check" /></svg><div><strong>{copy("controlTitle")}</strong><span>{copy("controlBody")}</span></div></li>
            </ul>
            <p class="mcp-preview-note">{copy("note")}</p>
          </div>
        </div>
        <ol class="wrap mcp-steps" aria-label={copy("stepsLabel")}>
          <li><span>{copy("step1")}</span><h3>{copy("step1Title")}</h3><p>{copy("step1Body")}</p></li>
          <li><span>{copy("step2")}</span><h3>{copy("step2Title")}</h3><p>{copy("step2Body")}</p></li>
          <li><span>{copy("step3")}</span><h3>{copy("step3Title")}</h3><p>{copy("step3Body")}</p></li>
        </ol>
      </section>
