---
import Logo from '@components/Logo.astro';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import { useI18n, type Locale } from '@i18n';

/**
 * The site chrome, redrawn to the reference geometry (LMW-03, D-3/D-4).
 *
 * Two things and nothing else sit on the 74 px fixed bar: a dark pill on the
 * left carrying the logo and the menu button, and two calls to action on the
 * right. The navigation did not disappear — the five items, the seven
 * solution destinations and the language control live inside the panel the
 * menu button opens, at EVERY width. That panel is the same `#mobile-menu`
 * (focus trap, Escape, focus returned to the toggle) the header always had;
 * it simply stopped being mobile-only.
 *
 * `<nav class="site-header__nav">` keeps `class` as its first attribute on
 * purpose: `tests/home-names-every-solution.spec.ts` anchors on that literal
 * to read the seven destinations the menu offers.
 */

type SubItem = { label: string; href: string; divider?: boolean };
type NavItem = { label: string; href: string; subItems?: SubItem[] };

interface Props {
  /** Path per locale, forwarded to the language control. Same map that feeds
   *  the hreflang block, so the control and the crawler agree on what exists. */
  alternates: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;
const { t, l } = useI18n(Astro.url.pathname);

const APP_URL = 'https://app.1platform.pro/app/';

// `l()` is applied here, once, so every consumer below compares and renders the
// same localised href. The Docs entry is an absolute URL and `l()` returns it
// untouched — that is the case the helper exists to get right.
const solutionsSubItems: SubItem[] = [
  { label: t('nav.solutions.onlineStore'), href: l('/solutions/online-store/') },
  { label: t('nav.solutions.website'), href: l('/solutions/website/') },
  { label: t('nav.solutions.content'), href: l('/solutions/content/') },
  { label: t('nav.solutions.deliveries'), href: l('/solutions/deliveries/') },
  { label: t('nav.solutions.ads'), href: l('/solutions/ads/') },
  { label: t('nav.solutions.whitelabel'), href: l('/solutions/whitelabel/') },
  { label: t('nav.solutions.payments'), href: l('/payments-invoicing/') },
  { label: '', href: '', divider: true },
  { label: t('nav.solutions.viewAll'), href: l('/solutions/') },
];

const navItems: NavItem[] = [
  { label: t('nav.solutions'), href: l('/solutions/'), subItems: solutionsSubItems },
  { label: t('nav.features'), href: l('/features/') },
  { label: t('nav.pricing'), href: l('/pricing/') },
  { label: t('nav.docs'), href: 'https://developer.1platform.pro/' },
  { label: t('nav.blog'), href: l('/blog/') },
];

const currentPath = Astro.url.pathname;

/**
 * Whether a nav item points at the page being viewed. Compared against the
 * already-localised href so it holds in both trees; absolute hrefs are excluded
 * because "startsWith" is meaningless against another origin.
 */
const isActive = (href: string) => href.startsWith('/') && currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <div class="brand-pill">
      <Logo class="brand-pill__logo" />
      <button
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.aria.toggleMenu')}
        id="menu-toggle"
      >
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <div class="site-header__actions">
      <a href={APP_URL} class="ref-btn ref-btn--yellow site-header__signin">{t('cta.signIn')}</a>
      <a href={APP_URL} class="ref-btn ref-btn--orange">{t('cta.getStarted')}</a>
    </div>
  </div>

  <!-- The menu panel. Opened by the pill's button at every width. -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="site-header__nav" aria-label={t('nav.aria.main')}>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
            {item.subItems && (
              <ul class="mobile-menu__sublist">
                {item.subItems.map((sub) => (
                  sub.divider ? null : (
                    <li>
                      <a href={sub.href}>{sub.label}</a>
                    </li>
                  )
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a href={APP_URL} class="ref-btn ref-btn--orange ref-btn--full">{t('cta.getStarted')}</a>
    <LanguageSwitcher alternates={alternates} />
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', initMenu);

  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    /** All focusable elements inside the panel + the toggle button. */
    function getFocusableElements(): HTMLElement[] {
      const els = menu!.querySelectorAll<HTMLElement>('a, button, [tabindex]:not([tabindex="-1"])');
      return [toggle!, ...Array.from(els)];
    }

    function closeMenu() {
      toggle!.setAttribute('aria-expanded', 'false');
      menu!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggle!.focus();
    }

    function openMenu() {
      toggle!.setAttribute('aria-expanded', 'true');
      menu!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const firstLink = menu!.querySelector<HTMLElement>('a');
      firstLink?.focus();
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (toggle!.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
        return;
      }

      // Focus trap: cycle Tab within the panel while it is open.
      if (e.key === 'Tab' && toggle!.getAttribute('aria-expanded') === 'true') {
        const focusable = getFocusableElements();
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // A click outside the pill and the panel closes it, like any menu.
    document.addEventListener('click', (e) => {
      if (toggle!.getAttribute('aria-expanded') !== 'true') return;
      const target = e.target as Node;
      if (menu!.contains(target) || toggle!.contains(target)) return;
      closeMenu();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>

<style>
  /* Measured on the reference: header 74 px tall with 16 px padding, fixed,
     transparent — the page scrolls under it. It sits below the announcement
     bar when there is one (`--header-top`, set by BaseLayout). */
  .site-header {
    position: fixed;
    top: var(--header-top);
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    padding: 16px;
    background: transparent;
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .site-header__inner > * {
    pointer-events: auto;
  }

  /* The pill: 230 × 42, r6, dark, 1 px hairline; logo + wordmark left, the
     40 × 40 menu button flush right. */
  .brand-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 230px;
    height: 42px;
    padding: 1px;
    background: var(--ref-pill);
    border: 1px solid var(--ref-hairline-dark);
    border-radius: var(--ref-radius-s);
    color: var(--ref-white);
  }

  .brand-pill :global(.brand-pill__logo) {
    height: 38px;
    padding: 0 12px;
    font-size: 1.125rem;
  }

  .brand-pill :global(.logo__text) {
    color: var(--ref-white);
  }

  .site-header__menu-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: none;
    border: none;
    border-radius: var(--ref-radius-s);
    cursor: pointer;
    color: var(--ref-white);
    touch-action: manipulation;
  }

  /* 40 px visual, 44 px target (MUST): the extra 2 px each side is a hit
     area, not a drawn box. */
  .site-header__menu-toggle::after {
    content: '';
    position: absolute;
    inset: -2px;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 14px;
  }

  .hamburger span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hamburger span {
      transition: transform var(--duration-normal) ease,
                  opacity var(--duration-fast) ease;
    }
  }

  #menu-toggle[aria-expanded='true'] .hamburger span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }

  #menu-toggle[aria-expanded='true'] .hamburger span:nth-child(2) {
    opacity: 0;
  }

  #menu-toggle[aria-expanded='true'] .hamburger span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* The panel opens from the pill: same dark surface, anchored under it,
     360 px wide on desktop and edge-to-edge on phones. */
  .mobile-menu {
    display: none;
    position: fixed;
    top: calc(var(--header-offset) - 8px);
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100dvh - var(--header-offset) - 8px);
    overflow-y: auto;
    background: var(--ref-pill);
    color: var(--ref-white);
    border: 1px solid var(--ref-hairline-dark);
    border-radius: var(--ref-radius-m);
    padding: var(--space-4);
    z-index: 99;
    pointer-events: auto;
  }

  .mobile-menu[aria-hidden='false'] {
    display: block;
  }

  /* Without JavaScript the button cannot open anything, and a navigation that
     only exists behind a script is no navigation. The panel is then shown in
     place, permanently, under the pill — the site stays fully usable (this
     repo's RF-10), which `tests/language-detection.spec.ts` asserts without JS.
     Same media feature the reveal pattern in global.css already relies on. */
  @media (scripting: none) {
    .mobile-menu {
      display: block;
      position: absolute;
      top: calc(100% - 8px);
    }

    .site-header__menu-toggle {
      display: none;
    }
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-menu .nav-link,
  .mobile-menu .mobile-menu__sublist a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--ref-radius-s);
    color: var(--ref-white);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .mobile-menu a:hover,
  .mobile-menu a:focus-visible {
    background: var(--ref-card-dark);
  }

  .mobile-menu .nav-link.is-active {
    box-shadow: inset 3px 0 0 var(--ref-orange);
  }

  .mobile-menu .mobile-menu__sublist {
    gap: 0;
    margin: var(--space-1) 0 var(--space-2) var(--space-3);
    padding-left: var(--space-3);
    border-left: 1px solid var(--ref-hairline-dark);
  }

  .mobile-menu .mobile-menu__sublist a {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--ref-fg-dim);
  }

  .mobile-menu .mobile-menu__sublist a:hover,
  .mobile-menu .mobile-menu__sublist a:focus-visible {
    color: var(--ref-white);
  }

  .mobile-menu :global(.ref-btn--full) {
    margin-top: var(--space-4);
  }

  .mobile-menu :global(.lang) {
    margin-top: var(--space-4);
  }

  .site-header :focus-visible {
    outline-color: var(--ref-white);
  }

  /* Phones: the pill shrinks to logo + button and only the primary call to
     action stays — measured on the reference at 390 px. */
  @media (max-width: 768px) {
    .brand-pill {
      width: auto;
      min-width: 0;
    }

    .site-header__signin {
      display: none;
    }
  }
</style>
