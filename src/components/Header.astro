---
import Logo from '@components/Logo.astro';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import { useI18n, type Locale } from '@i18n';

type SubItem = { label: string; href: string };
type NavItem = { label: string; href: string; subItems?: SubItem[] };

interface Props {
  alternates: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;
const { t, l } = useI18n(Astro.url.pathname);
const appUrl = 'https://app.1platform.pro/app/';

const solutions: SubItem[] = [
  { label: t('nav.solutions.onlineStore'), href: l('/solutions/online-store/') },
  { label: t('nav.solutions.website'), href: l('/solutions/website/') },
  { label: t('nav.solutions.content'), href: l('/solutions/content/') },
  { label: t('nav.solutions.deliveries'), href: l('/solutions/deliveries/') },
  { label: t('nav.solutions.ads'), href: l('/solutions/ads/') },
  { label: t('nav.solutions.whitelabel'), href: l('/solutions/whitelabel/') },
  { label: t('nav.solutions.payments'), href: l('/payments-invoicing/') },
];

const navItems: NavItem[] = [
  { label: t('nav.solutions'), href: l('/solutions/'), subItems: solutions },
  // "Features" is gone: it was a smaller copy of /solutions/ — twelve of its
  // twenty-one headings appeared there verbatim, every destination it linked
  // was already linked there, and no page body on the site pointed at it.
  { label: t('nav.pricing'), href: l('/pricing/') },
  { label: t('nav.docs'), href: 'https://developer.1platform.pro/' },
  { label: t('nav.blog'), href: l('/blog/') },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/') && currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="site-header__rail">
    <Logo class="site-header__logo" />

    <nav class="site-header__nav" aria-label={t('nav.aria.main')}>
      <details class="site-header__solutions">
        <summary class:list={['site-header__link', 'nav-link', { 'is-active': isActive(l('/solutions/')) }]}>
          {t('nav.solutions')}<span class="site-header__chevron" aria-hidden="true"></span>
        </summary>
        <div class="solutions-menu">
          <ul>
            {solutions.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
          <a href={l('/solutions/')} class="solutions-menu__all">{t('nav.solutions.viewAll')}</a>
        </div>
      </details>
      {navItems.slice(1).map((item) => (
        <a href={item.href} class:list={['site-header__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a href={appUrl} class="site-header__signin">{t('cta.signIn')}</a>
      <a href={appUrl} class="btn btn--primary site-header__cta">{t('cta.getStarted')}</a>
      <button
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.aria.toggleMenu')}
        id="menu-toggle"
      >
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label={t('nav.aria.main')}>
      <ul class="mobile-menu__links">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={['mobile-menu__link', { 'is-active': isActive(item.href) }]}>{item.label}</a>
            {item.subItems && (
              <ul class="mobile-menu__sublist">
                {item.subItems.map((sub) => <li><a href={sub.href}>{sub.label}</a></li>)}
                <li><a href={l('/solutions/')}>{t('nav.solutions.viewAll')}</a></li>
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__footer">
      <a href={appUrl} class="btn btn--primary btn--full">{t('cta.getStarted')}</a>
      <LanguageSwitcher alternates={alternates} />
    </div>
  </div>
</header>

<script>
  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.wired) return;
    toggle.dataset.wired = 'true';

    const close = (returnFocus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (returnFocus) toggle.focus();
    };
    const open = () => {
      toggle.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      menu.querySelector<HTMLElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => (
      toggle.getAttribute('aria-expanded') === 'true' ? close() : open()
    ));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') close(true);
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close()));
  }

  document.addEventListener('astro:page-load', initMenu);
</script>

<style>
  .site-header { position: fixed; z-index: 100; top: calc(var(--header-top) + 32px); left: 0; right: 0; padding-inline: var(--space-4); pointer-events: none; }
  .site-header__rail { display: flex; align-items: center; gap: var(--space-8); width: min(1480px, 100%); min-height: 78px; margin: 0 auto; padding: 8px 12px 8px 28px; background: color-mix(in srgb, var(--color-surface) 97%, transparent); border: 1px solid var(--color-border); border-radius: var(--border-radius-pill); box-shadow: 0 1px 3px rgba(20, 22, 27, 0.04); pointer-events: auto; }
  .site-header :global(.site-header__logo) { font-size: var(--text-lg); }
  .site-header__nav { display: flex; align-items: center; gap: var(--space-2); margin-left: var(--space-8); }
  .site-header__solutions { position: relative; }
  .site-header__solutions summary { list-style: none; }
  .site-header__solutions summary::-webkit-details-marker { display: none; }
  .site-header__link, .site-header__signin { display: inline-flex; align-items: center; min-height: 40px; padding: 0 10px; border-radius: var(--border-radius-pill); color: var(--color-text); font-size: 0.95rem; font-weight: 500; cursor: pointer; white-space: nowrap; }
  .site-header__link:hover, .site-header__link:focus-visible, .site-header__link.is-active, .site-header__signin:hover { color: var(--color-accent); background: var(--color-bg-muted); }
  .site-header__chevron { width: 6px; height: 6px; margin-left: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .site-header__solutions[open] .site-header__chevron { transform: rotate(225deg) translateY(-1px); }
  .solutions-menu { position: absolute; top: calc(100% + 12px); left: -14px; width: 265px; padding: 10px; background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--border-radius-lg); box-shadow: var(--shadow-lg); }
  .solutions-menu ul { display: grid; gap: 1px; }
  .solutions-menu a { display: flex; min-height: 38px; align-items: center; padding: 7px 10px; border-radius: var(--border-radius); color: var(--color-text-secondary); font-size: var(--text-sm); }
  .solutions-menu a:hover, .solutions-menu a:focus-visible { background: var(--color-bg-muted); color: var(--color-text); }
  .solutions-menu__all { margin-top: 8px; border-top: 1px solid var(--color-border); padding-top: 12px !important; color: var(--color-accent) !important; }
  .site-header__actions { display: flex; align-items: center; gap: var(--space-2); margin-left: auto; }
  .site-header__cta { min-height: 56px; padding-inline: 25px; border-radius: var(--border-radius-pill); }
  .site-header__menu-toggle { display: none; width: 44px; height: 44px; padding: 0; place-content: center; gap: 5px; border: 0; border-radius: 50%; color: var(--color-text); background: var(--color-bg-muted); cursor: pointer; }
  .site-header__menu-toggle span { display: block; width: 16px; height: 1.5px; background: currentColor; }
  .mobile-menu { display: none; }
  .mobile-menu[aria-hidden='false'] { position: fixed; top: calc(var(--header-top) + 86px); right: var(--space-4); z-index: 99; display: block; width: min(420px, calc(100% - 32px)); padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--border-radius-xl); box-shadow: var(--shadow-lg); pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) { .site-header__link, .site-header__signin, .solutions-menu a, .site-header__menu-toggle span { transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease, transform var(--duration-fast) ease; } }
  @media (max-width: 980px) {
    .site-header__rail { padding-left: 14px; }
    .site-header__nav, .site-header__signin { display: none; }
    .site-header__menu-toggle { display: grid; }
    .mobile-menu { position: fixed; top: calc(var(--header-top) + 86px); right: var(--space-4); left: var(--space-4); z-index: 99; max-width: 620px; margin-left: auto; padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--border-radius-xl); box-shadow: var(--shadow-lg); pointer-events: auto; }
    .mobile-menu[aria-hidden='false'] { display: block; }
    .mobile-menu__links { display: grid; gap: var(--space-2); }
    .mobile-menu__link { display: flex; min-height: 44px; align-items: center; padding: 0 var(--space-3); border-radius: var(--border-radius); font-size: var(--text-lg); color: var(--color-text); }
    .mobile-menu__link.is-active, .mobile-menu__link:hover { background: var(--color-bg-muted); }
    .mobile-menu__sublist { display: grid; gap: 2px; margin: 0 0 var(--space-3) var(--space-4); padding-left: var(--space-4); border-left: 1px solid var(--color-border); }
    .mobile-menu__sublist a { display: flex; align-items: center; min-height: 34px; color: var(--color-text-secondary); font-size: var(--text-sm); }
    .mobile-menu__sublist a:hover { color: var(--color-accent); }
    .mobile-menu__footer { display: grid; gap: var(--space-4); margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--color-border); }
  }
  @media (max-width: 520px) { .site-header { padding-inline: var(--space-3); } .site-header__rail { min-height: 54px; padding: 5px 5px 5px 14px; } .site-header__cta { min-height: 42px; padding-inline: 12px; font-size: var(--text-xs); } .mobile-menu { right: var(--space-3); left: var(--space-3); padding: var(--space-5); } }
  @media (scripting: none) { .site-header { position: relative; top: auto; pointer-events: auto; } .site-header__menu-toggle { display: none; } .mobile-menu { display: block; position: static; width: min(620px, calc(100% - 32px)); margin: var(--space-3) auto 0; pointer-events: auto; } }
</style>
