---
import { useI18n } from '@i18n';
import { Image } from 'astro:assets';
import Icon from '@components/Icon.astro';
import SlotPlaceholder from './SlotPlaceholder.astro';
import { productMedia } from './media';

/**
 * The hero (LMW-04): the brand line in a 56 px serif, a fan of eleven planes —
 * a flat centre strip of four product screens and five rotated pairs curving
 * toward the reader — a three-line lead, and a search pill that takes you to
 * your solution.
 *
 * The fan exists twice on purpose (D-5): this CSS 3D layer is the page (LCP,
 * reduced motion, no JS, no WebGL), and `fan-scene.ts` upgrades it to a WebGL
 * canvas that reads its geometry FROM these data attributes — one source of
 * numbers, so the crossfade cannot jump. Angles and sizes are estimates from
 * the reference capture (D-19: the scene there is a canvas with no DOM to
 * measure), refined against it in the phase's design pass.
 *
 * The pill was measured live in F0: 320 × 57, radius 16, on the dark pill
 * surface.
 */
const { t, l } = useI18n(Astro.url.pathname);

const RADIUS = 1100;

/** The five pairs: angle (deg), width, height — inner pair first. */
const PAIRS: [number, number, number][] = [
  [16, 190, 210],
  [30, 220, 310],
  [42, 240, 550],
  [54, 250, 880],
  [66, 290, 900],
];

const strip = [1, 2, 3, 4].map((n) => productMedia(`hero-${String(n).padStart(2, '0')}`));
const sides = PAIRS.flatMap(([angle, w, h], i) => [
  { slot: `hero-${String(5 + i * 2).padStart(2, '0')}`, angle, w, h },
  { slot: `hero-${String(6 + i * 2).padStart(2, '0')}`, angle: -angle, w, h },
]).map((p) => ({ ...p, media: productMedia(p.slot) }));

const destinations = [
  { label: t('nav.solutions.onlineStore'), href: l('/solutions/online-store/') },
  { label: t('nav.solutions.website'), href: l('/solutions/website/') },
  { label: t('nav.solutions.content'), href: l('/solutions/content/') },
  { label: t('nav.solutions.deliveries'), href: l('/solutions/deliveries/') },
  { label: t('nav.solutions.ads'), href: l('/solutions/ads/') },
  { label: t('nav.solutions.whitelabel'), href: l('/solutions/whitelabel/') },
  { label: t('nav.solutions.payments'), href: l('/payments-invoicing/') },
];
---

<section id="hero" class="hero-ref ref-dot-grid">
  <figure class="fan" data-fan role="img" aria-label={t('home.hero.fan.aria')}>
    <div class="fan__stage">
      <div
        class="fan__plane fan__plane--strip"
        data-plane
        data-angle="0"
        data-radius={RADIUS}
        data-w="550"
        data-h="150"
        style="--angle:0deg; --w:550px; --h:150px;"
      >
        {strip.map((media, i) => (
          media.image ? (
            <Image
              src={media.image}
              width={media.slot.width}
              height={media.slot.height}
              alt={t(`home.media.hero-0${i + 1}`)}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <SlotPlaceholder spec={media.slot} />
          )
        ))}
      </div>
      {sides.map((plane) => (
        <div
          class="fan__plane"
          data-plane
          data-angle={plane.angle}
          data-radius={RADIUS}
          data-w={plane.w}
          data-h={plane.h}
          style={`--angle:${plane.angle}deg; --w:${plane.w}px; --h:${plane.h}px;`}
        >
          {plane.media.image ? (
            <Image
              src={plane.media.image}
              width={plane.media.slot.width}
              height={plane.media.slot.height}
              alt={t(`home.media.${plane.slot}`)}
              loading="lazy"
            />
          ) : (
            <SlotPlaceholder spec={plane.media.slot} />
          )}
        </div>
      ))}
    </div>
  </figure>
  <canvas class="hero-ref__canvas" data-scene="fan" hidden></canvas>

  <div class="hero-ref__copy">
    <h1 class="ref-h-display hero-ref__headline">{t('home.hero.headline')}</h1>
    <div class="hero-ref__foot">
      <p class="hero-ref__lead">{t('home.hero.lead')}</p>
      <form class="hero-search" method="get" action={l('/solutions/')} data-solution-search>
        <label class="sr-only" for="hero-search-input">{t('home.hero.search.label')}</label>
        <input
          id="hero-search-input"
          class="hero-search__input ref-body-s"
          type="text"
          name="q"
          list="hero-solutions"
          placeholder={t('home.hero.search.placeholder')}
          autocomplete="off"
        />
        <datalist id="hero-solutions">
          {destinations.map((d) => (
            <option value={d.label} data-href={d.href}></option>
          ))}
        </datalist>
        <button type="submit" class="hero-search__go" aria-label={t('home.hero.search.submit')}>
          <Icon name="arrow-right" size={16} />
        </button>
      </form>
    </div>
  </div>

  <div class="hero-ref__rule" aria-hidden="true">
    <span class="hero-ref__rule-a"></span>
    <span class="hero-ref__rule-b"></span>
    <span class="hero-ref__rule-c"></span>
    <span class="hero-ref__rule-d"></span>
  </div>
</section>

<script>
  /**
   * The search pill navigates straight to the chosen solution (LMW-04 CA-4).
   * The <datalist> filters natively; on submit the typed value is matched to
   * its destination and the browser goes there. Without JavaScript the form
   * GETs /solutions/ — the catalogue — which is the honest fallback.
   */
  function initHeroSearch() {
    const form = document.querySelector<HTMLFormElement>('[data-solution-search]');
    if (!form || form.dataset.wired) return;
    form.dataset.wired = 'true';

    form.addEventListener('submit', (e) => {
      const input = form.querySelector<HTMLInputElement>('input');
      const value = (input?.value ?? '').trim().toLowerCase();
      if (!value) return;
      const options = Array.from(form.querySelectorAll<HTMLOptionElement>('datalist option'));
      const match =
        options.find((o) => o.value.toLowerCase() === value) ??
        options.find((o) => o.value.toLowerCase().includes(value));
      if (match?.dataset.href) {
        e.preventDefault();
        globalThis.location.href = match.dataset.href;
      }
    });
  }

  document.addEventListener('astro:page-load', initHeroSearch);
</script>

<style>
  /* Measured: 860 tall at 1440 (the section starts under the 40 px bar), H1
     at y 141 within it, lead 480 wide at 557, pill 320 × 57 at 665, and a
     four-colour rule on the bottom edge. At 390 the H1 takes three lines and
     the section DROPS to 804 (the paddings shrink). */
  .hero-ref {
    position: relative;
    height: 860px;
    /* The fixed chrome is out of flow; the section starts under the
       announcement bar so the H1 lands at the measured y = 181. */
    margin-top: var(--header-top);
    overflow: hidden;
  }

  .fan {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .fan__stage {
    --fan-radius: 1100px;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    perspective: 1200px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fan__stage {
      transition: opacity 400ms var(--ease-out-expo);
    }
  }

  .fan--upgraded .fan__stage {
    opacity: 0;
  }

  .fan__plane {
    position: absolute;
    width: var(--w);
    height: var(--h);
    margin-left: calc(var(--w) / -2);
    margin-top: calc(var(--h) / -2);
    transform: rotateY(var(--angle)) translateZ(calc(var(--fan-radius) * -1));
  }

  .fan__plane :global(img),
  .fan__plane :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--ref-radius-s);
  }

  /* The centre strip: four screens on a dark film-strip frame. */
  .fan__plane--strip {
    display: flex;
    gap: 4px;
    padding: 6px;
    background: var(--ref-ink);
    border-radius: var(--ref-radius-s);
  }

  .fan__plane--strip :global(img),
  .fan__plane--strip :global(svg) {
    flex: 1;
    min-width: 0;
    aspect-ratio: 1;
    height: auto;
    align-self: center;
    border-radius: 4px;
  }

  .hero-ref__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The global reset says `canvas { display: block }`, and any author rule
     beats the UA's `[hidden] { display: none }` — so without this line the
     `hidden` attribute never actually hid anything. */
  .hero-ref__canvas[hidden] {
    display: none;
  }

  .hero-ref__copy {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 141px 32px 0;
    text-align: center;
    pointer-events: none;
  }

  .hero-ref__headline {
    max-width: 533px;
    color: var(--ref-ink);
  }

  .hero-ref__foot {
    margin-top: auto;
    margin-bottom: 138px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    pointer-events: auto;
  }

  .hero-ref__lead {
    max-width: 480px;
    font-size: var(--text-base);
    line-height: 24px;
    color: var(--ref-ink);
    margin: 0;
  }

  /* Measured live on the reference in F0: 320 × 57, radius 16. */
  .hero-search {
    display: flex;
    align-items: center;
    width: 320px;
    height: 57px;
    padding: 0 8px 0 15px;
    background: var(--ref-pill);
    border: 1px solid var(--ref-hairline-dark);
    border-radius: 16px;
  }

  .hero-search__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--ref-white);
  }

  .hero-search__input::placeholder {
    color: var(--ref-fg-dim);
  }

  .hero-search__input:focus-visible {
    outline: none;
  }

  .hero-search:focus-within {
    outline: 2px solid var(--ref-orange);
    outline-offset: 2px;
  }

  .hero-search__go {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ref-card-dark);
    color: var(--ref-white);
    cursor: pointer;
  }

  /* 40 px drawn, 44 px target. */
  .hero-search__go::after {
    content: '';
    position: absolute;
    inset: -2px;
  }

  .hero-ref__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    display: flex;
  }

  .hero-ref__rule span {
    flex: 1;
  }

  /* Four solid blocks, never a gradient (RT1-4): the two systems' accents and
     the two the reference's rule carries. */
  .hero-ref__rule-a {
    background-color: var(--ref-orange);
  }

  .hero-ref__rule-b {
    background-color: var(--ref-yellow);
  }

  .hero-ref__rule-c {
    background-color: var(--cobalt);
  }

  .hero-ref__rule-d {
    background-color: var(--signal);
  }

  @media (max-width: 768px) {
    .hero-ref {
      height: 804px;
    }

    .hero-ref__copy {
      padding: 96px 20px 0;
    }

    .hero-ref__foot {
      margin-bottom: 40px;
    }

    .fan__stage {
      transform: scale(0.55);
    }
  }
</style>
