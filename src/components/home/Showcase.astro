---
import { useI18n } from '@i18n';
import { Image } from 'astro:assets';
import Icon from '@components/Icon.astro';
import SlotPlaceholder from './SlotPlaceholder.astro';
import { productMedia } from './media';
import ShowcasePanel from './ShowcasePanel.astro';
import { SHOWCASE } from './showcase-content';

/**
 * The scroll-pinned showcase (LMW-05): an editorial business moment stays put
 * behind each solution while its connected product nodes scroll past it, and
 * a floating pill names the solution on screen. Backgrounds tell the human
 * outcome; node cards remain the evidence of the real product workflow.
 *
 * Geometry measured on the reference: section 3 419 px at 1440 (padding
 * 216/0/344, five 559 px panels with a 16 px gap), pill 353 × 114 at x 243,
 * panels 780 × 559 at x 650. At 390: 2 363 px, 357 px panels, the pill anchored
 * to the bottom.
 *
 * Without JavaScript nothing is lost: the first background shows, every panel
 * is visible in order, and the tabs are plain anchors to their panels. The
 * script only moves the highlight.
 */
const { t, l } = useI18n(Astro.url.pathname);

const solutions = SHOWCASE.map((solution) => ({
  ...solution,
  label: t(solution.labelKey),
  bg: productMedia(`showcase-${solution.slug}-bg`),
}));
---

<section id="canvas" class="showcase ref-dot-grid--dark" aria-label={t('home.showcase.aria')}>
  <div class="showcase__pin" aria-hidden="true">
    <div class="showcase__bg">
      {solutions.map((solution, i) => (
        <div
          class:list={['showcase__bgimg', i === 0 && 'is-active']}
          data-bg={solution.slug}
          style={`--showcase-bg-x:${solution.bgFocalX}%;`}
        >
          {solution.bg.image ? (
            i === 0 ? (
              <Image
                src={solution.bg.image}
                width={solution.bg.slot.width}
                height={solution.bg.slot.height}
                widths={[390, 780, 1024, 1440, 1920, 2048, 2880]}
                sizes="100vw"
                layout="full-width"
                alt=""
                loading="lazy"
                fetchpriority="low"
              />
            ) : (
              <template data-bg-template>
                <Image
                  src={solution.bg.image}
                  width={solution.bg.slot.width}
                  height={solution.bg.slot.height}
                  widths={[390, 780, 1024, 1440, 1920, 2048, 2880]}
                  sizes="100vw"
                  layout="full-width"
                  alt=""
                  loading="lazy"
                  fetchpriority="low"
                />
              </template>
            )
          ) : (
            <SlotPlaceholder spec={solution.bg.slot} />
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="showcase__pin showcase__pin--ui">
    <div class="showcase__pill" data-showcase-pill>
      <div class="showcase__tabs-clip">
        <div class="showcase__tabs" role="tablist" aria-label={t('home.showcase.tabs.aria')} data-tabs>
          {solutions.map((solution, i) => (
            <a
              href={`#canvas-showcase-${solution.slug}`}
              role="tab"
              id={`showcase-tab-${solution.slug}`}
              class:list={['showcase__tab', 'ref-body-s', i === 0 && 'is-active']}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`canvas-showcase-${solution.slug}`}
              tabindex={0}
              data-tab={solution.slug}
            >
              {solution.label}
            </a>
          ))}
        </div>
      </div>
      <div class="showcase__entries">
        {solutions.map((solution, i) => (
          <a
            href={l(solution.href)}
            class:list={['showcase__entry', i === 0 && 'is-active']}
            data-entry={solution.slug}
            aria-label={t('home.showcase.entry.aria', { label: solution.label })}
          >
            <Icon name={solution.icon} size={18} />
            <span class="ref-body-s">{solution.label}</span>
            <span class="showcase__entry-go" aria-hidden="true">
              <Icon name="arrow-right" size={16} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="showcase__panels">
    {solutions.map((solution) => (
      <ShowcasePanel solution={solution} />
    ))}
  </div>
</section>

<script>
  /**
   * Progressive behaviour (D-10): the scroll picks the active
   * solution; a tab click scrolls to its panel; arrows move the selection.
   * Lenis owns smooth anchor scrolling when it is running — this only takes
   * over when it is not (reduced motion), where a plain jump is correct.
   */
  function initShowcase() {
    const root = document.getElementById('canvas');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = 'true';

    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
    const strip = root.querySelector<HTMLElement>('[data-tabs]');
    const backgrounds = Array.from(root.querySelectorAll<HTMLElement>('[data-bg]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-panel]'));
    const reduced = globalThis.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let backgroundRequest = 0;

    async function ensureBackground(background: HTMLElement): Promise<boolean> {
      let image = background.querySelector<HTMLImageElement>('img');
      if (!image && background.querySelector('[data-placeholder]')) return true;
      if (!image) {
        const template = background.querySelector<HTMLTemplateElement>('[data-bg-template]');
        if (!template) return false;
        background.append(template.content.cloneNode(true));
        template.remove();
        image = background.querySelector<HTMLImageElement>('img');
      }
      if (!image) return false;
      if (image.complete) return image.naturalWidth > 0;
      try {
        await image.decode();
        return image.naturalWidth > 0;
      } catch {
        return false;
      }
    }

    function selectBackground(slug: string) {
      const request = ++backgroundRequest;
      const background = backgrounds.find((candidate) => candidate.dataset.bg === slug);
      if (!background) return;
      void ensureBackground(background).then((ready) => {
        if (!ready || request !== backgroundRequest) return;
        for (const candidate of backgrounds) {
          candidate.classList.toggle('is-active', candidate === background);
        }
      });
    }

    function activate(slug: string) {
      selectBackground(slug);
      for (const el of root!.querySelectorAll<HTMLElement>('[data-entry]')) {
        el.classList.toggle('is-active', el.dataset.entry === slug);
      }
      for (const tab of tabs) {
        const active = tab.dataset.tab === slug;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && strip) {
          // Keep the active tab inside the 353 px pill: slide the strip left
          // just enough, never right of its start.
          const clipWidth = strip.parentElement!.clientWidth;
          const overflow = tab.offsetLeft + tab.offsetWidth - clipWidth + 8;
          strip.style.transform = `translateX(${Math.min(0, -Math.max(0, overflow))}px)`;
        }
      }
    }

    function scrollToPanel(slug: string) {
      const panel = panels.find((candidate) => candidate.dataset.showcasePanel === slug);
      if (!panel) return;
      const offset = -Math.max(0, (globalThis.innerHeight - panel.offsetHeight) / 2);
      const lenis = (globalThis as {
        __lenis?: { scrollTo: (target: HTMLElement, options?: { offset?: number }) => void };
      }).__lenis;
      if (!reduced && lenis) {
        lenis.scrollTo(panel, { offset });
        return;
      }
      const top = globalThis.scrollY + panel.getBoundingClientRect().top + offset;
      globalThis.scrollTo({ top, behavior: 'instant' });
    }

    const visibility = new Map(panels.map((panel) => [panel, 0]));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visibility.set(entry.target as HTMLElement, entry.isIntersecting ? entry.intersectionRatio : 0);
        }
        const active = panels
          .filter((panel) => (visibility.get(panel) ?? 0) > 0)
          .sort((a, b) => {
            const ratio = (visibility.get(b) ?? 0) - (visibility.get(a) ?? 0);
            if (Math.abs(ratio) > 0.01) return ratio;
            const centre = globalThis.innerHeight / 2;
            const aBox = a.getBoundingClientRect();
            const bBox = b.getBoundingClientRect();
            return (
              Math.abs(aBox.top + aBox.height / 2 - centre) -
              Math.abs(bBox.top + bBox.height / 2 - centre)
            );
          })[0];
        const slug = active?.dataset.showcasePanel;
        if (slug) activate(slug);
      },
      { threshold: [0, 0.5, 1] },
    );
    for (const panel of panels) observer.observe(panel);

    for (const [i, tab] of tabs.entries()) {
      tab.addEventListener(
        'click',
        (e) => {
          const slug = tab.dataset.tab!;
          e.preventDefault();
          e.stopImmediatePropagation();
          activate(slug);
          if (globalThis.location.hash !== tab.hash) {
            globalThis.history.pushState(null, '', tab.hash);
          }
          scrollToPanel(slug);
        },
        { capture: true },
      );
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        next.focus();
        next.click();
      });
    }

    function restoreRequestedPanel(): boolean {
      const requested = tabs.find((tab) => tab.hash === globalThis.location.hash);
      const requestedSlug = requested?.dataset.tab;
      if (!requestedSlug) return false;
      activate(requestedSlug);
      globalThis.requestAnimationFrame(() => scrollToPanel(requestedSlug));
      return true;
    }

    globalThis.addEventListener('popstate', restoreRequestedPanel);
    document.addEventListener(
      'astro:before-swap',
      () => globalThis.removeEventListener('popstate', restoreRequestedPanel),
      { once: true },
    );
    if (!restoreRequestedPanel()) {
      const firstSlug = tabs[0]?.dataset.tab;
      if (firstSlug) activate(firstSlug);
    }
  }

  document.addEventListener('astro:page-load', initShowcase);
</script>

<style>
  /* 216 + 5·559 + 4·16 + 344 = 3 419 (measured). */
  .showcase {
    position: relative;
    padding: 216px 0 344px;
    color: var(--ref-white);
  }

  .showcase__pin {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .showcase__bg {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .showcase__bgimg {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .showcase__bgimg {
      transition: opacity 400ms var(--ease-out-expo);
    }
  }

  .showcase__bgimg.is-active {
    opacity: 1;
  }

  .showcase__bgimg :global(img),
  .showcase__bgimg :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--showcase-bg-x) center;
  }

  /* The floating pill: sticky with the section, 353 wide, at x 243 / y 216. */
  .showcase__pin--ui {
    z-index: 2;
  }

  .showcase__pill {
    position: sticky;
    top: 216px;
    margin-left: 243px;
    width: 353px;
    border-radius: var(--ref-radius-m);
    background: var(--ref-pill);
    border: 1px solid var(--ref-hairline-dark);
    pointer-events: auto;
  }

  .showcase__tabs-clip {
    overflow: hidden;
    border-bottom: 1px solid var(--ref-hairline-dark);
  }

  .showcase__tabs {
    display: flex;
    gap: 8px;
    padding: 8px;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .showcase__tabs {
      transition: transform 300ms var(--ease-out-expo);
    }
  }

  .showcase__tab {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: var(--ref-radius-s);
    color: var(--ref-white);
    white-space: nowrap;
  }

  .showcase__tab.is-active {
    background: var(--ref-orange-cta);
  }

  .showcase__entries {
    position: relative;
    min-height: 55px;
  }

  .showcase__entry {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    gap: 10px;
    padding: 0 8px 0 16px;
    color: var(--ref-white);
  }

  .showcase__entry.is-active {
    display: flex;
  }

  .showcase__entry-go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ref-card-dark);
  }

  .showcase__entry:hover .showcase__entry-go,
  .showcase__entry:focus-visible .showcase__entry-go {
    background: var(--ref-orange-cta);
  }

  .showcase__panels {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 1;
  }

  .showcase :global(:focus-visible) {
    outline-color: var(--ref-white);
  }

  /* 203 + 5·357 + 4·16 + 311 = 2 363 (measured at 390). The pill anchors to
     the bottom edge instead of the top. */
  @media (max-width: 768px) {
    .showcase {
      padding: 203px 0 311px;
    }

    .showcase__bg {
      height: 100dvh;
    }

    .showcase__pill {
      position: sticky;
      top: auto;
      margin: 0 16px;
      width: auto;
      /* Sticky-to-bottom: the pill sits 16 px above the viewport's lower edge
         while its wrapper is in view. */
      top: calc(100dvh - 130px);
    }
  }
</style>
