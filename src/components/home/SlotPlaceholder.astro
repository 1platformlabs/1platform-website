---
import { useI18n } from '@i18n';
import type { MediaSlot } from './media-slots';

/**
 * What a media hole shows until its real product capture exists.
 *
 * Drawn in the schematic language of `InterconnectDiagram` — hairline grid,
 * one node, one trace — at the exact size of the hole, so layout, LCP and the
 * fidelity measurements are identical with or without the final image. The
 * slot id is printed on it: a placeholder that looks finished is how a hole
 * ships empty, so this one says what it is. `data-placeholder` is what
 * `tests/media-complete.spec.ts` counts.
 */
interface Props {
  /** Named `spec`, not `slot`: `slot` is Astro's reserved slotting prop. */
  spec: MediaSlot;
  class?: string;
}

const { spec, class: className } = Astro.props;
const { t } = useI18n(Astro.url.pathname);
const { width, height } = spec;
const pitch = 24;
const nodeW = Math.min(width * 0.42, 160);
const nodeH = Math.min(height * 0.18, 44);
const nodeX = (width - nodeW) / 2;
const nodeY = height * 0.38;
---

<svg
  class:list={['slot-ph', className]}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  role="img"
  aria-label={t('home.media.placeholderAria', { slot: spec.id })}
  data-placeholder={spec.id}
>
  <defs>
    <pattern id={`ph-grid-${spec.id}`} width={pitch} height={pitch} patternUnits="userSpaceOnUse">
      <path d={`M ${pitch} 0 L 0 0 0 ${pitch}`} fill="none" class="slot-ph__grid" />
    </pattern>
  </defs>
  <rect width={width} height={height} class="slot-ph__bg" />
  <rect width={width} height={height} fill={`url(#ph-grid-${spec.id})`} />
  <path d={`M ${width / 2} ${nodeY + nodeH} V ${height * 0.78}`} class="slot-ph__trace" />
  <rect x={nodeX} y={nodeY} width={nodeW} height={nodeH} rx="6" class="slot-ph__node" />
  <text x={width / 2} y={height * 0.78 + 18} text-anchor="middle" class="slot-ph__label">{spec.id}</text>
</svg>

<style>
  .slot-ph {
    display: block;
    width: 100%;
    height: 100%;
  }

  .slot-ph__bg {
    fill: var(--ref-gray);
  }

  .slot-ph__grid {
    stroke: var(--ref-hairline-light);
    stroke-width: 1;
  }

  .slot-ph__trace {
    stroke: var(--ref-orange);
    stroke-width: 1.5;
    fill: none;
  }

  .slot-ph__node {
    fill: var(--ref-white);
    stroke: var(--ref-hairline-light);
  }

  .slot-ph__label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ref-ink);
    letter-spacing: 0.08em;
  }
</style>
