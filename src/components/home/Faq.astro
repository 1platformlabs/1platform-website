---
import { useI18n } from '@i18n';
import { FAQ_KEYS } from './faq-content';

/**
 * The FAQ (LMW-09, D-13): eight native <details> rows — six answers the
 * pricing page already publishes, two new — 61 px closed, hairline between,
 * a plus that becomes a cross. `name="faq"` makes opening one close the rest;
 * nothing needs JavaScript.
 */

const { t } = useI18n(Astro.url.pathname);

const items = FAQ_KEYS.map((key) => ({
  question: t(`${key}.question`),
  answer: t(`${key}.answer`),
}));
---

<section id="faq" class="faq">
  <div class="faq__inner">
    <h2 class="ref-h-display faq__title">{t('home.faq.title')}</h2>
    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item" name="faq">
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__plus" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Measured: 821 tall, padding 160/43.2/80, an 896 container, the H2 on the
     LEFT (the one left-aligned opener of the page), 8 rows of 61. */
  .faq {
    background: var(--ref-dark);
    padding: 160px 43.2px 80px;
    color: var(--ref-white);
  }

  .faq__inner {
    width: 896px;
    max-width: 100%;
    margin: 0 auto;
  }

  .faq__title {
    color: var(--ref-white);
    margin: 0 0 32px;
  }

  .faq__item {
    border-bottom: 1px solid var(--ref-hairline-dark);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 61px;
    padding: 16px 0;
    font-size: var(--text-base);
    line-height: 24px;
    color: var(--ref-white);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__plus {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6.5px;
    width: 14px;
    height: 1.5px;
    background: var(--ref-white);
  }

  .faq__plus::after {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__plus::after {
      transition: transform 200ms var(--ease-out-expo);
    }
  }

  .faq__item[open] .faq__plus::after {
    transform: rotate(45deg);
  }

  .faq__item[open] .faq__plus::before {
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__plus::before {
      transition: transform 200ms var(--ease-out-expo);
    }
  }

  .faq__answer {
    max-width: 720px;
    padding: 0 0 20px;
    margin: 0;
    font-size: var(--text-base);
    line-height: 24px;
    color: var(--ref-fg-dim);
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--ref-white);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .faq {
      padding: 80px 16px 40px;
    }
  }
</style>
