---
import { useI18n } from '@i18n';
import NodeCard from './NodeCard.astro';
import { wirePath, type ShowcaseSolution } from './showcase-content';

/**
 * One 780 × 559 panel of connected nodes, aligned to the right of a 1440
 * frame with 10 px of margin — measured on the reference (LMW-05 CA-1). The
 * connectors are cubic curves with the exact orange at their endpoints; they
 * carry no text and no meaning of their own, so the orange needs no AA tint.
 */
interface Props {
  solution: ShowcaseSolution;
}

const { solution } = Astro.props;
const { t, l } = useI18n(Astro.url.pathname);
const label = t(solution.labelKey);

const wires = solution.wires.map(([from, to]) =>
  wirePath(solution.nodes[from - 1], solution.nodes[to - 1]),
);
---

<section
  id={`canvas-showcase-${solution.slug}`}
  class="showcase-panel"
  data-showcase-panel={solution.slug}
  aria-label={t('home.showcase.panel.aria', { label })}
>
  <div class="showcase-panel__board">
    <svg class="showcase-panel__wires" viewBox="0 0 780 559" aria-hidden="true">
      {wires.map((d) => (
        <path d={d} class="wire" />
      ))}
      {wires.map((d) => {
        const start = d.match(/^M ([\d.]+) ([\d.]+)/);
        const end = d.match(/C.*?, ([\d.]+) ([\d.]+)$/);
        return (
          <>
            {start && <circle cx={start[1]} cy={start[2]} r="4" class="wire-dot" />}
            {end && <circle cx={end[1]} cy={end[2]} r="4" class="wire-dot" />}
          </>
        );
      })}
    </svg>
    {solution.nodes.map((node) => (
      <NodeCard slug={solution.slug} node={node} solutionLabel={label} />
    ))}
    <a class="showcase-panel__open ref-body-s" href={l(solution.href)}>
      {t('home.showcase.entry.aria', { label })}
    </a>
  </div>
</section>

<style>
  .showcase-panel {
    display: flex;
    justify-content: flex-end;
    padding-right: 10px;
    height: 559px;
  }

  .showcase-panel__board {
    position: relative;
    width: 780px;
    height: 559px;
    border-radius: var(--ref-radius-m);
    background: var(--ref-panel);
    overflow: hidden;
  }

  .showcase-panel__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wire {
    fill: none;
    stroke: var(--ref-orange);
    stroke-width: 1.5;
  }

  .wire-dot {
    fill: var(--ref-orange);
  }

  /* The whole panel already sits inside a section that the pill links to; the
     board's own "open" affordance is a quiet corner link. */
  .showcase-panel__open {
    position: absolute;
    right: 12px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 8px;
    color: var(--ref-fg-dim);
    border-radius: var(--ref-radius-s);
  }

  .showcase-panel__open:hover,
  .showcase-panel__open:focus-visible {
    color: var(--ref-white);
  }

  @media (max-width: 768px) {
    .showcase-panel {
      padding: 0 16px;
      height: 357px;
    }

    .showcase-panel__board {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      align-content: center;
      padding: 12px;
    }

    .showcase-panel__wires {
      display: none;
    }

    .showcase-panel__open {
      position: static;
      grid-column: 1 / -1;
      justify-self: end;
    }
  }
</style>
