---
import { useI18n } from '@i18n';
import { Image } from 'astro:assets';
import SlotPlaceholder from './SlotPlaceholder.astro';
import { productMedia } from './media';
import { NODE_PADDING, nodeHeight, type ShowcaseNode } from './showcase-content';

/**
 * One node of a showcase panel: a labelled card with a product capture and a
 * step chip, in the connector language `InterconnectDiagram` established
 * (LMW-05 CA-3). A node with an `href` links to another solution's page —
 * that is how Website and Whitelabel appear inside store and content.
 */
interface Props {
  slug: string;
  node: ShowcaseNode;
  /** The owning solution's visible name (top-right of the card). */
  solutionLabel: string;
}

const { slug, node, solutionLabel } = Astro.props;
const { t } = useI18n(Astro.url.pathname);

const label = t(`home.showcase.${slug}.node.${node.n}.label`);
const chip = t(`home.showcase.${slug}.node.${node.n}.chip`);
const media = productMedia(`showcase-${slug}-node-${node.n}`);
const mediaSize = node.w - 2 * NODE_PADDING;

const Tag = node.href ? 'a' : 'article';
---

<Tag
  href={node.href}
  class:list={['node', node.href && 'node--linked']}
  style={`--x:${node.x}px; --y:${node.y}px; --w:${node.w}px; --h:${nodeHeight(node.w)}px;`}
>
  <span class="node__head ref-body-s">
    <span class="node__label">{label}</span>
    <span class="node__module">{solutionLabel}</span>
  </span>
  <span class="node__media">
    {media.image ? (
      <Image
        src={media.image}
        width={media.slot.width}
        height={media.slot.height}
        alt={t(`home.media.showcase-${slug}-node-${node.n}`)}
        loading="lazy"
      />
    ) : (
      <SlotPlaceholder spec={media.slot} />
    )}
    <span class="node__chip ref-body-s">{chip}</span>
  </span>
</Tag>

<style>
  .node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    display: flex;
    flex-direction: column;
    padding: 0 8px 8px;
    border: 1px solid var(--ref-hairline-dark);
    border-radius: var(--ref-radius-s);
    background: var(--ref-dark-2);
    color: var(--ref-white);
  }

  .node__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 32px;
    color: var(--ref-white);
  }

  .node__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node__module {
    color: var(--ref-fg-dim);
    flex-shrink: 0;
  }

  .node__media {
    position: relative;
    flex: 1;
    border-radius: 4px;
    overflow: hidden;
  }

  .node__media :global(img),
  .node__media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .node__chip {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 2px 8px;
    border-radius: var(--ref-radius-s);
    background: var(--ref-orange-cta);
    color: var(--ref-white);
  }

  a.node:hover .node__label,
  a.node:focus-visible .node__label {
    text-decoration: underline;
  }

  .node :global(:focus-visible),
  a.node:focus-visible {
    outline: 2px solid var(--ref-white);
    outline-offset: 2px;
  }

  /* Below 769 px the board is a grid (see ShowcasePanel) and the coordinates
     stop applying. */
  @media (max-width: 768px) {
    .node {
      position: static;
      width: auto;
      height: auto;
    }

    .node__media {
      aspect-ratio: 1;
      flex: none;
    }

    .node__head {
      min-height: 28px;
    }

    .node__module {
      display: none;
    }
  }
</style>
