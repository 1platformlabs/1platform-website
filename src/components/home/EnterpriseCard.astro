---
import { useI18n } from '@i18n';
import Check from '@components/Check.astro';

/**
 * The wide closing card of the pricing grid (LMW-08 CA-4): 1200 × 274, the
 * light gray surface, the mark in a dark square on the left, the whitelabel /
 * enterprise pitch with a two-column feature list and an ink CTA to sales.
 */
const { t, l } = useI18n(Astro.url.pathname);

const features = [
  t('home.pricing.enterprise.f1'),
  t('home.pricing.enterprise.f2'),
  t('home.pricing.enterprise.f3'),
  t('home.pricing.enterprise.f4'),
];
---

<article class="ent reveal">
  <span class="ent__logo" aria-hidden="true">
    <span class="ent__mark">1</span>
  </span>
  <div class="ent__pitch">
    <h3 class="ent__name">{t('home.pricing.enterprise.name')}</h3>
    <p class="ent__tagline">{t('home.pricing.enterprise.tagline')}</p>
    <a href={l('/contact/')} class="ref-btn ref-btn--ink ent__cta">{t('home.pricing.enterprise.cta')}</a>
  </div>
  <ul class="ent__features">
    {features.map((feature) => (
      <li class="ref-body-s">
        <Check yes={true} />
        {feature}
      </li>
    ))}
  </ul>
</article>

<style>
  .ent {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 40px;
    height: 274px;
    padding: 12px 40px 12px 12px;
    background: var(--ref-gray);
    border-radius: var(--ref-radius-m);
    color: var(--ref-ink);
  }

  .ent__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 250px;
    height: 250px;
    flex-shrink: 0;
    background: var(--ref-ink);
    border-radius: var(--ref-radius-m);
  }

  .ent__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 22px;
    background: var(--cobalt);
    color: var(--surface);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
    padding-right: 3px;
  }

  .ent__pitch {
    max-width: 360px;
  }

  .ent__name {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 32px;
    letter-spacing: -1.28px;
    font-weight: 500;
    margin: 0 0 8px;
    color: var(--ref-ink);
  }

  .ent__tagline {
    font-size: var(--text-base);
    line-height: 24px;
    color: var(--ref-ink);
    margin: 0 0 20px;
  }

  .ent__features {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 24px;
    align-content: center;
  }

  .ent__features li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ref-ink);
  }

  @media (max-width: 900px) {
    .ent {
      flex-direction: column;
      align-items: flex-start;
      height: auto;
      padding: 16px;
      gap: 20px;
    }

    .ent__logo {
      width: 120px;
      height: 120px;
    }

    .ent__mark {
      width: 48px;
      height: 48px;
      font-size: 32px;
      border-radius: 11px;
    }

    .ent__features {
      grid-template-columns: 1fr;
    }
  }
</style>
