---
import type { CollectionEntry } from 'astro:content';
import Icon from '@components/Icon.astro';
import { useI18n, formatDate } from '@i18n';
import { bareSlug } from '@i18n/collections';
import { archiveSummary, displayHeading } from '@lib/blog-presentation';
interface Props { post: CollectionEntry<'blog'>; hidden?: boolean; }
const { post, hidden = false } = Astro.props;
const { t, l, locale } = useI18n(Astro.url.pathname, Astro.locals);
---
<article class="archive-item" data-category={post.data.category} hidden={hidden}>
  <a class="archive-link" href={l(`/blog/${bareSlug(post.id)}/`)} aria-labelledby={`article-${post.data.translationKey}`}>
    <div class="archive-meta"><span class="category">{t(`interiors.category.${post.data.category}`)}</span>{post.data.readingTime && <span>{t('blog.readingTime', { n: post.data.readingTime })}</span>}</div>
    <h3 id={`article-${post.data.translationKey}`}>{displayHeading(post.data.title)}</h3>
    <p class="archive-summary">{displayHeading(archiveSummary(post, locale))}</p>
    <div class="archive-foot"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time><span class="archive-read">{t('interiors.read')}<Icon name="arrow-right-short" /></span></div>
  </a>
</article>
