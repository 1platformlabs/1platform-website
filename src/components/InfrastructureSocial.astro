---
import { useI18n } from '@i18n';
import { i18nKey } from '@i18n/key';
import { supportUrl } from '@lib/site-destinations';
const { t } = useI18n(Astro.url.pathname, Astro.locals);
const prefix = i18nKey('infrastructure.social.');
const copy = (key: string) => t(`${prefix}${key}`).replaceAll('{brand}', Astro.locals.tenant.brand_name);
const contactHref = supportUrl(Astro.locals);
---
<section class="section social-agent" id="agente-redes" aria-labelledby="social-agent-title">
        <div class="wrap social-agent-layout">
          <div class="social-agent-copy">
            <p class="eyebrow">{copy("eyebrow")}</p>
            <h2 id="social-agent-title">{copy("title")}</h2>
            <p>{copy("description")}</p>
            <ul class="social-stages" aria-label={copy("listLabel")}>
              <li>{copy("receive")}</li>
              <li>{copy("context")}</li>
              <li>{copy("need")}</li>
              <li>{copy("schedule")}</li>
            </ul>
            {contactHref && <a class="text-link" href={contactHref}>{copy("cta")}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>}
          </div>
          <div class="social-demo" data-social-demo data-phase="0"
    data-presence={copy("presence")} data-typing={copy("typing")} data-paused-label={copy("paused")} data-hint={copy("hint")} data-static={copy("static")} data-resume={copy("resume")} data-pause-label={copy("pause")} data-no-animation={copy("noAnimation")} tabindex="0" role="group" aria-label={copy("demoLabel")} aria-describedby="social-demo-note">
            <div class="social-demo-header"><span class="social-avatar" aria-hidden="true"><svg class="icon"><use href="#infra-i-spark" /></svg></span><div><strong>{copy("brand")}</strong><span data-social-presence>{copy("presence")}</span></div><span class="social-demo-badge">DEMO</span></div>
            <div class="social-conversation" data-lenis-prevent tabindex="0" role="region" aria-label={copy("chatLabel")}>
              <span class="social-chat-day">{copy("today")}</span>
              <div class="social-message social-message--lead" data-message-phase="0" aria-label={copy("lead")}><p>{copy("message0")}</p><span class="social-message-time" aria-hidden="true">10:24 <span class="social-read"><svg viewBox="0 0 24 16"><path d="m1 8 4 4L15 2m-5 9 2 2L23 2" /></svg></span></span></div>
              <div class="social-message social-message--agent" data-message-phase="1" aria-label={copy("agent")}><p>{copy("message1")}</p><span class="social-message-time" aria-hidden="true">10:24</span></div>
              <div class="social-message social-message--lead" data-message-phase="2" aria-label={copy("lead")}><p>{copy("message2")}</p><span class="social-message-time" aria-hidden="true">10:25 <span class="social-read"><svg viewBox="0 0 24 16"><path d="m1 8 4 4L15 2m-5 9 2 2L23 2" /></svg></span></span></div>
              <div class="social-message social-message--agent" data-message-phase="3" aria-label={copy("agent")}><p>{copy("message3")}</p><span class="social-message-time" aria-hidden="true">10:25</span></div>
              <div class="social-message social-message--lead" data-message-phase="4" aria-label={copy("lead")}><p>{copy("message4")}</p><span class="social-message-time" aria-hidden="true">10:25 <span class="social-read"><svg viewBox="0 0 24 16"><path d="m1 8 4 4L15 2m-5 9 2 2L23 2" /></svg></span></span></div>
              <div class="social-message social-message--agent" data-message-phase="5" aria-label={copy("agent")}><p>{copy("message5")}</p><span class="social-message-time" aria-hidden="true">10:26</span></div>
              <div class="social-message social-message--lead" data-message-phase="6" aria-label={copy("lead")}><p>{copy("message6")}</p><span class="social-message-time" aria-hidden="true">10:26 <span class="social-read"><svg viewBox="0 0 24 16"><path d="m1 8 4 4L15 2m-5 9 2 2L23 2" /></svg></span></span></div>
              <div class="social-message social-message--agent" data-message-phase="7" aria-label={copy("agent")}><p>{copy("message7")}</p><div class="social-appointment"><strong>{copy("confirmed")}</strong><span>{copy("time")}</span><span>{copy("zone")}</span></div><span class="social-message-time" aria-hidden="true">10:26</span></div>
              <div class="social-message social-message--agent social-typing" data-social-typing hidden role="status" aria-label={copy("typingLabel")}><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></div>
            </div>
            <div class="social-composer" aria-hidden="true"><span class="social-compose-field"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 14c2 3 6 3 8 0M8 9h1m6 0h1"/></svg>{copy("input")}<svg viewBox="0 0 24 24"><path d="m8 12 6-6a3 3 0 0 1 4 4l-8 8a5 5 0 0 1-7-7l8-8" /></svg></span><span class="social-mic"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6 11v1a6 6 0 0 0 12 0v-1M12 18v3m-3 0h6"/></svg></span></div>
            <div class="social-playback"><span data-social-status>{copy("initial")}</span><button type="button" data-social-pause hidden aria-pressed="false">{copy("pause")}</button></div>
          </div>
        </div>
        <p class="wrap social-agent-note" id="social-demo-note">{copy("note")}</p>
      </section>
