---
import { iconPaths, type IconName } from '@components/icons';

/**
 * The preset's own copy of `@components/Icon.astro`, same registry and same
 * markup. Importing the shared component from editorial pages made Astro share
 * its scoped `.icon` rule across two bundles, so it left the platform's
 * `BaseLayout` stylesheet and became an inline `<style>` on every 1platform.pro
 * page: same rendering, different bytes, and the byte-for-byte gate went red
 * (/implement-epic 2026-11-09). The rule lives in `editorial.css` instead.
 */
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['icon', className]}
  set:html={iconPaths[name]}
/>
