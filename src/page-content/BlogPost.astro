---
import BlogLayout from '@layouts/BlogLayout.astro';
import { localizePath, type Locale } from '@i18n';
import type { BlogPost as CorePost } from '@lib/site-blog';
import type { RenderedBody } from '@lib/editorial-render';

interface Props {
  post: CorePost;
  rendered: RenderedBody;
  locale: Locale;
}

const { post, rendered, locale } = Astro.props;

/**
 * Which languages this post exists in.
 *
 * Read from the Core (`alternates`: published posts of THIS site with the same
 * translation key, in languages the site declares) rather than assumed, because
 * a post is the one kind of page that can legitimately have no twin. When it
 * has none, the map has a single entry and three things follow at once: no
 * hreflang promises a translation, the language switcher shows the other
 * language as unavailable, and the auto-detect script finds nothing to redirect
 * to. One fact, read once.
 */
const alternates: Partial<Record<Locale, string>> = {
  [locale]: localizePath(`/blog/${post.slug}/`, locale),
};
for (const [other, otherSlug] of Object.entries(post.alternates)) {
  alternates[other as Locale] = localizePath(`/blog/${otherSlug}/`, other as Locale);
}

const frontmatter = {
  title: post.title,
  description: post.description,
  pubDate: new Date(post.published_at ?? 0),
  updatedDate: post.updated_at ? new Date(post.updated_at) : undefined,
  author: post.author ?? Astro.locals.tenant.brand_name,
  category: post.category,
  image: post.image ?? undefined,
  ogImage: post.og_image ?? undefined,
  readingTime: post.reading_minutes ?? undefined,
  tags: post.tags,
};
---

<BlogLayout
  frontmatter={frontmatter}
  headings={rendered.headings}
  slug={post.slug}
  alternates={alternates}
>
  <Fragment set:html={rendered.html} />
</BlogLayout>
