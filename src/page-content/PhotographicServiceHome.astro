<div class="panel-action-row">
<span><svg aria-hidden="true" class="icon">
<use href="#i-card"></use></svg>{copy('ui.label7')}</span><button class="panel-text-button" data-panel-go="billing" hidden="" type="button">{copy('ui.panel_text_button')}<span aria-hidden="true"><svg aria-hidden="true" class="icon"><use href="#i-arrow"></use></svg></span>
</button>
</div>
<div class="panel-action-row">
<span><svg aria-hidden="true" class="icon">
<use href="#i-download"></use></svg>{copy('ui.label9')}</span><button class="panel-text-button" data-panel-go="withdrawals" hidden="" type="button">{copy('ui.panel_text_button10')}<span aria-hidden="true"><svg aria-hidden="true" class="icon"><use href="#i-arrow"></use></svg></span>
</button>
</div>
</section>
<div class="panel-summary-grid">
<section aria-labelledby="chart-title" class="panel-card panel-chart">
<div class="panel-card-heading">
<span class="panel-eyebrow">{copy('ui.panel_eyebrow11')}</span>
<h4 id="chart-title">{copy('ui.chart_title')}</h4>
</div>
<div class="panel-chart-body">
<span class="panel-chart-label">{copy('ui.panel_chart_label')}</span><svg aria-label={copy('ui.svg_aria_label')} role="img" viewBox="0 0 540 140">
<path class="chart-grid" d="M0 20h540M0 70h540M0 120h540"></path>
<path class="chart-line" d="M0 110 49 110 98 104 147 105 196 92 245 95 294 80 343 82 392 60 441 65 490 42 530 38"></path>
<circle cx="530" cy="38" r="5"></circle>
</svg>
<div class="panel-chart-axis">
<span>{copy('ui.label14')}</span><span>{copy('ui.label15')}</span>
</div>
</div>
</section>
<section aria-labelledby="credit-title" class="panel-card panel-credit">
<div class="panel-card-heading">
<h4 class="panel-eyebrow" id="credit-title">{copy('ui.credit_title')}</h4>
<span class="panel-chip">{panel.currency}</span>
</div>
<div class="panel-credit-body">
<strong class="panel-money" data-panel-money="credit">{money(panel.sample.creditCents)}</strong>
<p>{copy('ui.label17')}</p>
<button class="panel-primary" data-panel-go="billing" hidden="" type="button">{copy('ui.panel_primary')}<svg aria-hidden="true" class="icon">
<use href="#i-arrow"></use>
</svg>
</button>
</div>
</section>
</div>
</div>
<div aria-labelledby="panel-tab-billing" data-panel-screen="" id="panel-billing" tabindex="0">
<h3 class="panel-page-title">{copy('ui.panel_page_title')}</h3>
<p class="panel-page-desc">{copy('ui.panel_page_desc')}</p>
<section aria-label={copy('ui.panel_card_panel_balance_aria_label')} class="panel-card panel-balance">
<div class="panel-between">
<span class="panel-eyebrow">{copy('ui.credit_title')}</span><span class="panel-chip">{panel.currency}</span>
</div>
<strong class="panel-money" data-panel-money="credit">{money(panel.sample.creditCents)}</strong>
<p class="panel-callout">{copy('ui.panel_callout')}</p>
</section>
<section aria-labelledby="transactions-title" class="panel-card panel-transactions">
<div class="panel-transactions-head">
<h4 id="transactions-title">{copy('ui.transactions_title')}</h4>
<div aria-label={copy('ui.panel_filters_aria_label')} class="panel-filters" role="group">
<button aria-pressed="true" data-panel-filter="all" hidden="" type="button">{copy('ui.label23')}</button><button aria-pressed="false" data-panel-filter="expense" hidden="" type="button">{copy('ui.label24')}</button><button aria-pressed="false" data-panel-filter="income" hidden="" type="button">{copy('ui.label25')}</button>
</div>
</div>
<table>
<caption class="sr-only">{copy('ui.sr_only')}</caption>
<thead>
<tr>
<th scope="col">{copy('ui.label27')}</th>
<th scope="col">{copy('ui.label28')}</th>
<th scope="col">{copy('ui.label29')}</th>
</tr>
</thead>
<tbody id="panel-transaction-rows">{panel.movements.map((item) => <tr data-panel-movement={item.type}><td>{item.text}</td><td>{item.date}</td><td class={item.type}>{money(item.cents)}</td></tr>)}</tbody>
</table>
<p class="panel-filter-status" id="panel-filter-status" role="status">{copy('ui.movements_fictional')}</p>
</section>
</div>
<div aria-labelledby="panel-tab-withdrawals" data-panel-screen="" id="panel-withdrawals" tabindex="0">
<div class="panel-withdraw-heading">
<div>
<h3 class="panel-page-title">{copy('ui.panel_page_title30')}</h3>
<p class="panel-page-desc">{copy('ui.panel_page_desc31')}</p>
</div>
<button aria-describedby="withdraw-reason" class="panel-disabled" disabled="" type="button">{copy('ui.panel_disabled')}</button>
</div>
<p class="panel-callout" id="withdraw-reason">{copy('ui.withdraw_reason')}</p>
<div class="panel-withdraw-balances">
<section aria-labelledby="withdraw-gtq" class="panel-card">
<h4 id="withdraw-gtq">{copy('ui.withdraw_gtq')}</h4>
<strong class="panel-money" data-panel-money="withdraw">{money(panel.sample.withdrawCents)}</strong>
<p>{copy('ui.label35')}</p>
</section>
</div>
<section aria-labelledby="method-title" class="panel-card panel-empty">
<svg aria-hidden="true" class="icon">
<use href="#i-card"></use>
</svg>
<h4 id="method-title">{copy('ui.method_title')}</h4>
<p>{copy('ui.label37')}</p>
<details>
<summary>{copy('ui.label38')}</summary>
<ul>
<li>{copy('ui.label39')}</li>
<li>{copy('ui.label40')}</li>
<li>{copy('ui.label41')}</li>
</ul>
</details>
</section>
</div>
</div>
</div>
</div>
<div class="panel-footnote">
<p>{copy('panel.note')}</p>
<a class="text-button" data-support-cta="panel" href={contactHref('panel')}>
<span>{copy('panel.contact')}</span><svg aria-hidden="true" class="icon">
<use href="#i-arrow"></use>
</svg>
</a>
</div>
<p class="panel-explanation">{copy('panel.explanation')}</p>
</div>
</section>
<section aria-labelledby="audience-title" class="audience-section section-pad wrap" id="para-quien">
<div class="section-heading">
<div>
<p class="eyebrow">{copy('audience.eyebrow')}</p>
<h2 id="audience-title">{copy('audience.title')}</h2>
</div>
<p class="section-intro">{copy('audience.description')}</p>
</div>
<div class="audience-grid" id="audience-list">{audiences.map((item) => <article class="audience-card"><span class="audience-icon"><svg class="icon" aria-hidden="true"><use href={`#i-${item.icon}`} /></svg></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
</section>
<section aria-labelledby="onboarding-title" class="onboarding-section wrap">
<div class="onboarding-card">
<div class="onboarding-copy">
<p class="eyebrow">{copy('onboarding.eyebrow')}</p>
<h2 id="onboarding-title">{copy('onboarding.title')}</h2>
<p>{copy('onboarding.description')}</p>
{productLinks.length > 0 && <ul class="landing-product-links">{productLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}</ul>}
<a class="button button-teal" data-support-cta="onboarding" href={contactHref('onboarding')}>
<span>{copy('actions.onboarding')}</span><svg aria-hidden="true" class="icon">
<use href="#i-up-right"></use>
</svg>
</a>
</div>
<div class="onboarding-photo">
<Image alt={copy('ui.img_alt')} format="webp" height={photoHeight} loading="lazy" quality={90} sizes="(min-width: 981px) 50vw, 100vw" src={heroPhoto} width={photoWidth} widths={[640, 960, 1280, 1672]}/>
</div>
</div>
</section>
<section aria-labelledby="calculator-title" class="calculator-section section-pad wrap" id="calculadora">
{defaultCalculation?.ok ? <>
<form class="calculator-form" id="price-calculator" novalidate="">
<h3>{copy('calculator.formTitle')}</h3>
<div class="calc-field amount-field">
<label for="calc-amount">{copy('calculator.amount')}</label>
<div class="amount-input">
<span aria-hidden="true">Q</span><input aria-describedby="calc-error" autocomplete="off" disabled="" id="calc-amount" inputmode="decimal" maxlength="10" name="amount" required="" type="text" value="100.00"/>
</div>
</div>
<div class="calc-pricing">
<div>
<span>{copy('calculator.rate')}</span><strong data-commission="">{rateLabel}</strong>
</div>
<span class="calc-no-fixed">{copy('calculator.terms')}</span>
</div>
<button class="button button-teal calc-submit" hidden="" type="submit">
<span>{copy('calculator.submit')}</span><svg aria-hidden="true" class="icon"><use href="#i-arrow"></use></svg>
</button>
<p class="calc-error" id="calc-error" role="alert"></p>
<div aria-atomic="true" aria-live="polite" class="calc-result" role="status">
<span>{copy('calculator.result')}</span><output id="calc-net">{calculatorMoney(defaultCalculation.net)}</output>
<dl>
<div>
<dt>{copy('calculator.fee')}</dt>
<dd id="calc-fee">{calculatorMoney(defaultCalculation.fee)}</dd>
</div>
</dl>
<p id="calc-status">{copy('ui.calculator_nojs')}</p>
</div>
</form>
<div class="calculator-copy">
<p class="eyebrow">{copy('calculator.eyebrow')}</p>
<h2 id="calculator-title">{copy('calculator.title')}</h2>
<p class="calculator-intro">{copy('calculator.description')}</p>
<a class="button button-teal" data-support-cta="calculator" href={contactHref('calculator')}>
<span>{copy('calculator.contact')}</span><svg aria-hidden="true" class="icon">
<use href="#i-up-right"></use>
</svg>
</a>
<p class="calculator-note">{copy('calculator.note')}</p>
</div>
</> : <>
<div class="calculator-form pricing-card">
<h3>{copy('pricing.heading')}</h3>
<dl>
<div><dt>{copy('pricing.balanceLabel')}</dt><dd>{copy('pricing.balanceValue')}</dd></div>
<div><dt>{copy('pricing.rateLabel')}</dt><dd>{copy('pricing.rateValue')}</dd></div>
</dl>
<p>{copy('pricing.note')}</p>
</div>
<div class="calculator-copy">
<p class="eyebrow">{copy('calculator.eyebrow')}</p>
<h2 id="calculator-title">{copy('pricing.title')}</h2>
<p class="calculator-intro">{copy('pricing.description')}</p>
<a class="button button-teal" href={pricingHref}><span>{copy('pricing.cta')}</span><svg aria-hidden="true" class="icon"><use href="#i-arrow" /></svg></a>
</div>
</>}
</section>
<section aria-labelledby="faq-title" class="faq-section section-pad wrap" id="preguntas">
<div class="faq-heading">
<p class="eyebrow">{copy('faq.eyebrow')}</p>
<h2 id="faq-title">{copy('faq.title')}</h2>
<a class="text-button" data-support-cta="question" href={contactHref('question')}>
<span>{copy('actions.question')}</span><svg aria-hidden="true" class="icon"><use href="#i-arrow"></use></svg>
</a>
</div>
<div class="faq-list" id="faq-list">{faqs.map((item) => <details><summary><span>{item.question}</span><svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg></summary><p>{item.answer}</p></details>)}</div>
</section>
<section aria-labelledby="closing-title" class="closing-section">
<div class="wrap closing-content">
<span aria-hidden="true" class="closing-mark">{tenant.brand_mark ?? tenant.brand_name}</span>
<h2 id="closing-title">{copy('closing.title')}</h2>
<a class="button button-white" data-support-cta="closing" href={contactHref('closing')}>
<svg aria-hidden="true" class="icon"><use href="#i-chat"></use></svg><span>{copy('actions.primary')}</span><svg aria-hidden="true" class="icon">
<use href="#i-up-right"></use>
</svg>
</a>
</div>
</section>
</main>
<footer class="site-footer">
<div class="wrap footer-grid">
<div class="footer-brand">
<a aria-label={copy('ui.brand_back').replace('{brand}', tenant.brand_name)} class="brand" href="#inicio"><span aria-hidden="true" class="brand-mark">{tenant.brand_mark ?? tenant.brand_name}</span><span class="wordmark">{tenant.brand_wordmark ?? tenant.brand_name}</span></a>
<p>{copy('footer.description')}</p>
</div>
<nav aria-label={copy('ui.footer_column_aria_label')} class="footer-column">
<h2>{copy('footer.solutions')}</h2>
{productLinks.length > 0 ? productLinks.map(({ href, label }) => <a href={href}>{label}</a>) : <>
<a href="#como-cobras">{copy('hero.feature1')}</a>
<a href="#como-cobras">{copy('hero.feature2')}</a>
<a href="#como-funciona">{copy('hero.feature3')}</a>
</>}
</nav>
<nav aria-label={copy('ui.footer_column_aria_label63')} class="footer-column">
<h2>{tenant.brand_name}</h2>
{companyLinks.length > 0 ? companyLinks.map(({ href, label }) => <a href={href}>{label}</a>) : <>
<a href="#como-funciona">{copy('ui.label42')}</a>
<a href="#su-panel">{copy('ui.label43')}</a>
<a href="#para-quien">{copy('ui.label44')}</a>
<a href="#calculadora">{copy('ui.label45')}</a>
<a href="#preguntas">{copy('ui.label46')}</a>
</>}
</nav>
<div class="footer-column">
<h2>{copy('footer.contact')}</h2>
<p>{copy('footer.coverage')}</p>
<a class="footer-contact" data-support-cta="footer" href={contactHref('footer')}>
<svg aria-hidden="true" class="icon"><use href="#i-chat"></use></svg><span>{copy('actions.header')}</span><svg aria-hidden="true" class="icon">
<use href="#i-up-right"></use>
</svg>
</a>
{legalLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
{tenant.destinations.docs && <a href={tenant.destinations.docs}>{copy('footer.docs')}</a>}
</div>
</div>
<div class="wrap footer-bottom">
<span>{copy('footer.copyright')}</span>
<a class="back-to-top" href="#inicio"><span>{copy('footer.back')}</span><svg aria-hidden="true" class="icon"><use href="#i-up-right"></use></svg></a>
</div>
</footer>


<script is:inline type="application/json" id="landing-config" set:html={safeJson(clientConfig)} />
<script>import '@scripts/photographic-service';</script></body>
</html>
