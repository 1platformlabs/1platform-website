<article class="service-card service-link" data-sequence="">
<div class="service-copy">
<h3>{copy('solutions.card2.title')}</h3>
<p>{copy('solutions.card2.description')}</p>
</div>
<div aria-label={copy('ui.service_stage_aria_label52')} class="service-stage" role="img">
<div class="product-panel link-panel">
<div class="product-heading">
<span class="mini-mark">{tenant.brand_mark ?? tenant.brand_name}</span><span>{tenant.brand_wordmark ?? tenant.brand_name}</span><svg aria-hidden="true" class="icon">
<use href="#i-link"></use>
</svg>
</div>
<div class="link-preview">
<span>{copy('illustrations.paymentLink')}</span><strong>{copy('illustrations.consultation')}</strong>
<p>{copy('illustrations.remoteDescription')}</p>
</div>
<div class="share-action">
<span>{copy('illustrations.remoteAction')}</span><svg aria-hidden="true" class="icon">
<use href="#i-up-right"></use>
</svg>
</div>
<div class="link-delivery">
<svg aria-hidden="true" class="icon">
<use href="#i-check"></use></svg><span>{copy('illustrations.share')}</span>
</div>
</div>
</div>
<div class="service-footnote">
<svg aria-hidden="true" class="icon"><use href="#i-link"></use></svg><span>{copy('hero.feature2')}</span>
</div>
</article>
<article class="service-card service-invoice" data-sequence="">
<div class="service-copy">
