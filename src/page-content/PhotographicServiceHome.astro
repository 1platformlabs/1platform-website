---
import { Image } from 'astro:assets';
import { useI18n, type Locale } from '@i18n';
import consultorio from '@assets/photographic/consultorio-hero.webp';
import commerce from '@assets/product/showcase-store-bg.webp';
import { photographicContent, safeJson } from '@lib/photographic-content';
import { calculateLandingAmount } from '@lib/landing-calculator';
import { siteOrigin } from '@lib/site-origin';
import { alternatesForTenantPath, defaultLocaleOf, makeLocalizePath, ogLocaleOf } from '@lib/site-locale';
import { resolveIcon, resolveSocial, resolveAppleTouchIcon, socialImageIsAvailable, appleTouchIconIsAvailable } from '@lib/tenant-brand-assets';
import '@styles/photographic-service.css';
import '@styles/photographic-panel.css';

const tenant = Astro.locals.tenant;
const { copy, contactHref, navigation, steps, audiences, faqs, calculator, panel, brandStyle, clientConfig, fontKey, palette } = photographicContent(Astro.locals.messages, tenant);
const photographs = { consultorio, commerce };
const photoKey = copy('hero.image');
if (!Object.hasOwn(photographs, photoKey)) throw new Error('Unrecognised photographic asset');
const heroPhoto = photographs[photoKey as keyof typeof photographs];
const photoWidth = Math.min(1672, heroPhoto.width);
const photoHeight = Math.round(photoWidth * heroPhoto.height / heroPhoto.width);
const title = copy('meta.title');
const description = copy('meta.description');
const canonical = new URL(Astro.originPathname, siteOrigin(Astro.locals));
const alternates = alternatesForTenantPath(tenant, Astro.originPathname);
const icon = resolveIcon(tenant);
const socialImage = await socialImageIsAvailable(tenant) ? new URL(resolveSocial(tenant), siteOrigin(Astro.locals)) : null;
const touchIcon = await appleTouchIconIsAvailable(tenant) ? resolveAppleTouchIcon(tenant) : null;
const locale = Astro.locals.locale;
const localize = makeLocalizePath(tenant);
const pricingHref = tenant.pages.includes('/pricing/') ? localize('/pricing/', locale) : contactHref('calculator');
const defaultAlternate = alternates[defaultLocaleOf(tenant)];
const rssPath = tenant.pages.includes('/blog/') ? localize('/rss.xml', locale) : null;
const languageChoices = Object.entries(alternates).filter(([language]) => language === 'en' || language === 'es');
const { t } = useI18n(Astro.url.pathname, Astro.locals);
// Published routes and their existing tenant-authored labels remain reachable
// when the home changes composition. Single-page tenants get no borrowed links.
const publishedLinks = (links: { route: string; label: () => string }[]) => links
  .filter(({ route }) => tenant.pages.includes(route))
  .map(({ route, label }) => ({ href: localize(route, locale), label: label() }));
const productLinks = publishedLinks([
  { route: '/solutions/online-store/', label: () => t('nav.solutions.onlineStore') },
  { route: '/payments-invoicing/', label: () => t('nav.solutions.payments') },
  { route: '/solutions/deliveries/', label: () => t('nav.solutions.deliveries') },
  { route: '/solutions/ads/', label: () => t('nav.solutions.ads') },
  { route: '/solutions/content/', label: () => t('nav.solutions.content') },
  { route: '/solutions/whitelabel/', label: () => t('nav.solutions.whitelabel') },
  { route: '/solutions/', label: () => t('footer.link.allSolutions') },
]);
const companyLinks = publishedLinks([
  { route: '/about/', label: () => t('footer.link.about') },
  { route: '/pricing/', label: () => t('nav.pricing') },
  { route: '/for-agencies/', label: () => t('footer.link.forAgencies') },
  { route: '/for-developers/', label: () => t('footer.link.forDevelopers') },
  { route: '/blog/', label: () => t('nav.blog') },
  { route: '/changelog/', label: () => t('footer.link.changelog') },
]);
const legalLinks = publishedLinks([
  { route: '/terms/', label: () => t('footer.link.terms') },
  { route: '/privacy/', label: () => t('footer.link.privacy') },
  { route: '/cookies/', label: () => t('footer.link.cookiePreferences') },
]);
const formatLocale = tenant.region ? `${locale}-${tenant.region}` : locale;
const money = (cents: number) => new Intl.NumberFormat(formatLocale, { style: 'currency', currency: panel.currency, currencyDisplay: 'narrowSymbol', minimumFractionDigits: 2 }).format(cents / 100);
const calculatorMoney = (cents: number) => new Intl.NumberFormat(formatLocale, { style: 'currency', currency: 'GTQ', currencyDisplay: 'narrowSymbol', minimumFractionDigits: 2 }).format(cents / 100);
const rateLabel = calculator ? new Intl.NumberFormat(formatLocale, { style: 'percent', maximumFractionDigits: 2 }).format(calculator.commissionBasisPoints / 10000) : null;
const defaultCalculation = calculator ? calculateLandingAmount('100.00', calculator.commissionBasisPoints) : null;
if (defaultCalculation && !defaultCalculation.ok) throw new Error('Invalid landing calculator configuration');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: tenant.brand_name, url: canonical.toString(), description },
  { '@context': 'https://schema.org', '@type': 'Organization', name: tenant.brand_name, url: canonical.toString(), ...(socialImage ? { logo: socialImage.toString() } : {}) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---
<!doctype html>
<html lang={formatLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={tenant.theme.accent} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!tenant.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {tenant.indexable && <link rel="sitemap" href="/sitemap-index.xml" />}
    {rssPath && <link rel="alternate" type="application/rss+xml" title={t('layout.rssTitle')} href={rssPath} />}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate, siteOrigin(Astro.locals))} />}
    {Object.entries(alternates).map(([language, path]) => <link rel="alternate" hreflang={language} href={new URL(path!, siteOrigin(Astro.locals))} />)}
    <link rel="icon" href={icon} type="image/svg+xml" />
    {touchIcon && <link rel="apple-touch-icon" href={touchIcon} />}
    {fontKey === 'manrope' && <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={tenant.brand_name} />
    <meta property="og:locale" content={ogLocaleOf(locale, tenant)} />
    {(Object.keys(alternates) as Locale[]).filter((language) => language !== locale).map((language) => <meta property="og:locale:alternate" content={ogLocaleOf(language, tenant)} />)}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script is:inline type="application/ld+json" set:html={safeJson(jsonLd)} />
    {languageChoices.length > 1 && <script is:inline>
      // Keep the established locale preference and stay on the current host.
      if (!window.__1pLangChecked) {
        window.__1pLangChecked = true;
        const path = location.pathname.toLowerCase();
        if (path !== '/es' && !path.startsWith('/es/')) {
          const cookie = /(?:^|;\s*)1p_lang=(en|es)(?:;|$)/.exec(document.cookie)?.[1];
          const language = navigator.language?.toLowerCase().split('-')[0];
          const wanted = cookie || (language ? language === 'en' ? 'en' : 'es' : 'en');
          const alternate = document.querySelector('link[rel="alternate"][hreflang="es"]');
          if (wanted === 'es' && alternate) {
            const target = new URL(alternate.getAttribute('href'), location.origin);
            if (target.pathname !== location.pathname) location.replace(target.pathname + location.search + location.hash);
          }
        }
      }
    </script>}
  </head>
<body class="photographic-service" data-home-template="photographic-service" data-palette={palette} data-language-choices={languageChoices.length > 1 ? '' : undefined} style={brandStyle}>
<a class="skip-link" href="#contenido">{copy('ui.skip_link')}</a>
<svg aria-hidden="true" class="icon-library" xmlns="http://www.w3.org/2000/svg">
<symbol id="i-arrow" viewBox="0 0 24 24">
<path d="M4 12h15m-6-6 6 6-6 6"></path>
</symbol>
<symbol id="i-up-right" viewBox="0 0 24 24">
<path d="M6 18 18 6M6 6h12v12"></path>
</symbol>
<symbol id="i-phone" viewBox="0 0 24 24">
<rect height="20" rx="3" width="12" x="6" y="2"></rect>
<path d="M10 5h4m-3 14h2"></path>
</symbol>
<symbol id="i-link" viewBox="0 0 24 24">
<path d="m10 13 4-4m-6 5-1 1a4 4 0 0 0 6 6l4-4a4 4 0 0 0 0-6m-1-1 1-1a4 4 0 0 0-6-6L7 7a4 4 0 0 0 0 6" transform="translate(0 -1)"></path>
</symbol>
<symbol id="i-check" viewBox="0 0 24 24">
<path d="m5 12 4 4L19 6"></path>
</symbol>
<symbol id="i-receipt" viewBox="0 0 24 24">
<path d="M5 3v18l3-2 4 2 4-2 3 2V3l-3 2-4-2-4 2-3-2Zm4 6h6m-6 4h6"></path>
</symbol>
<symbol id="i-chat" viewBox="0 0 24 24">
<path d="M21 11.5a9 9 0 0 1-9 9c-1.6 0-3-.4-4.4-1.1L3 21l1.5-4.6A9 9 0 1 1 21 11.5Z"></path>
<path d="M8 12h.01M12 12h.01M16 12h.01"></path>
</symbol>
<symbol id="i-person" viewBox="0 0 24 24">
<circle cx="12" cy="7" r="4"></circle>
<path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
</symbol>
<symbol id="i-clock" viewBox="0 0 24 24">
<circle cx="12" cy="12" r="9"></circle>
<path d="M12 7v5l3 2"></path>
</symbol>
<symbol id="i-team" viewBox="0 0 24 24">
<circle cx="9" cy="7" r="3"></circle>
<path d="M2 21v-3a7 7 0 0 1 14 0v3M16 4a3 3 0 0 1 0 6m3 4a6 6 0 0 1 3 5v2"></path>
</symbol>
<symbol id="i-plus" viewBox="0 0 24 24">
<path d="M5 12h14M12 5v14"></path>
</symbol>
<symbol id="i-home" viewBox="0 0 24 24">
<path d="m3 10 9-7 9 7v10H3Zm6 10v-7h6v7"></path>
</symbol>
<symbol id="i-card" viewBox="0 0 24 24">
<rect height="16" rx="2" width="20" x="2" y="4"></rect>
<path d="M2 9h20M6 15h4"></path>
</symbol>
<symbol id="i-download" viewBox="0 0 24 24">
<path d="M12 3v12m-5-5 5 5 5-5M4 15v6h16v-6"></path>
</symbol>
</svg>
<header class="site-header">
<a aria-label={copy('ui.brand_home').replace('{brand}', tenant.brand_name)} class="brand" href="#inicio">
<span aria-hidden="true" class="brand-mark">{tenant.brand_mark ?? tenant.brand_name}</span>
<span class="wordmark">{tenant.brand_wordmark ?? tenant.brand_name}</span>
</a>
<nav aria-label={copy('ui.desktop_nav_aria_label')} class="desktop-nav">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
{languageChoices.length > 1 && <nav class="landing-languages" aria-label={copy('ui.language_label')}>{languageChoices.map(([language, path]) => language === locale ? <span aria-current="true" lang={language}>{copy(`ui.language_${language}`)}</span> : <a href={path} hreflang={language} lang={language} data-lang-choice={language}>{copy(`ui.language_${language}`)}</a>)}</nav>}
<a class="button button-header" data-support-cta="header" href={contactHref('header')}>
<span>{copy('actions.header')}</span><svg aria-hidden="true" class="icon"><use href="#i-up-right"></use></svg>
</a>
<button aria-controls="mobile-menu" aria-expanded="false" aria-label={copy('ui.menu_toggle_aria_label')} class="menu-toggle" data-close-label={copy('ui.menu_close')} hidden="" type="button">
<span></span><span></span>
</button>
<nav aria-label={copy('ui.mobile_menu_aria_label')} class="mobile-nav" id="mobile-menu">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
</header>
<main id="contenido">
<section aria-labelledby="hero-title" class="hero" id="inicio">
<Image alt="" class="hero-photo" fetchpriority="high" format="webp" height={photoHeight} loading="eager" quality={90} src={heroPhoto} width={photoWidth}/>
<div class="hero-shade"></div>
<div class="hero-content wrap">
<h1 id="hero-title">
<span>{copy('hero.title1')}</span><span>{copy('hero.title2')}</span>
</h1>
<p class="hero-description">{copy('hero.description')}</p>
<div class="hero-actions">
<a class="button button-white" data-support-cta="hero" href={contactHref('hero')}>
<span>{copy('actions.primary')}</span><svg aria-hidden="true" class="icon">
<use href="#i-up-right"></use>
</svg>
</a>
<a class="button button-outline" href="#como-funciona"><span>{copy('actions.secondary')}</span><svg aria-hidden="true" class="icon"><use href="#i-arrow"></use></svg></a>
</div>
</div>
<div class="hero-bottom wrap">
<div class="hero-caption">
<p>{copy('hero.location')}</p>
</div>
<div class="hero-capabilities">
<span><svg aria-hidden="true" class="icon"><use href="#i-phone"></use></svg><span>{copy('hero.feature1')}</span></span>
<span><svg aria-hidden="true" class="icon"><use href="#i-link"></use></svg><span>{copy('hero.feature2')}</span></span>
<span><svg aria-hidden="true" class="icon">
<use href="#i-receipt"></use></svg><span>{copy('hero.feature3')}</span></span>
</div>
</div>
</section>
<section aria-labelledby="solutions-title" class="solutions section-pad wrap" id="como-cobras">
<div class="section-heading">
<div>
<p class="eyebrow">{copy('solutions.eyebrow')}</p>
<h2 id="solutions-title">{copy('solutions.title')}</h2>
</div>
</div>
<div class="solutions-grid">
<article class="service-card service-presencial" data-sequence="">
<div class="service-copy">
<h3>{copy('solutions.card1.title')}</h3>
<p>{copy('solutions.card1.description')}</p>
</div>
<div aria-label={copy('ui.service_stage_aria_label')} class="service-stage" role="img">
<div class="product-panel payment-panel">
<div class="product-heading">
<span class="mini-mark">{tenant.brand_mark ?? tenant.brand_name}</span><span>{tenant.brand_wordmark ?? tenant.brand_name}</span><svg aria-hidden="true" class="icon">
<use href="#i-phone"></use>
</svg>
</div>
<div class="payment-result">
<svg aria-hidden="true" class="confirmation-ring" viewBox="0 0 64 64">
<circle cx="32" cy="32" r="29"></circle>
<path d="m21 32 8 8 15-17"></path>
</svg>
<strong>{copy('illustrations.received')}</strong>
<span>{copy('illustrations.cardPayment')}</span>
</div>
<div class="product-footer">
