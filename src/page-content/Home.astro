---
/**
 * Home — the single most important page on the site. Its headline, subhead
 * and section copy set the voice for the whole Spanish tree.
 *
 * `home.hero.headline` is the one string on this page that is NOT translated:
 * it is the brand slogan ("One Platform. Every Solution."), which stays
 * English in both trees by the same rule that keeps "1Platform" itself
 * untranslated — see `common.ts` and the i18n contract's glossary.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Faq from '@components/home/Faq.astro';
import HeroFan from '@components/home/HeroFan.astro';
import ModuleCarousel from '@components/home/ModuleCarousel.astro';
import PersonaStack from '@components/home/PersonaStack.astro';
import PricingCards from '@components/home/PricingCards.astro';
import Showcase from '@components/home/Showcase.astro';
import { FAQ_KEYS } from '@components/home/faq-content';
import { useI18n } from '@i18n';

const { t, l } = useI18n(Astro.url.pathname);

const title = t('home.title');
const description = t('home.description');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t('home.jsonld.name'),
    url: new URL(l('/'), Astro.site).toString(),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: t('home.jsonld.name'),
    description,
    brand: {
      '@type': 'Brand',
      name: t('home.jsonld.brandName'),
    },
    offers: {
      '@type': 'Offer',
      url: new URL(l('/pricing/'), Astro.site).toString(),
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        priceType: 'PayPerUse',
      },
      availability: 'https://schema.org/InStock',
    },
  },
  // FAQPage as semantic structured data — Google retired FAQ rich results, so
  // this promises nothing about SERP appearance (D-13). The entries are the
  // SAME list the accordion renders, from one module, so the markup and the
  // data cannot drift apart.
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_KEYS.map((key) => ({
      '@type': 'Question',
      name: t(`${key}.question`),
      acceptedAnswer: { '@type': 'Answer', text: t(`${key}.answer`) },
    })),
  },
];


---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <HeroFan />
  <Showcase />
  <PersonaStack />
  <ModuleCarousel />

  <PricingCards />
  <Faq />

  <!-- The closing CTA lives in the footer, on every page — see Footer.astro. -->

  <script>
    // The WebGL upgrade path for the fan and the module carousel (D-5). Wired
    // here — the page that owns the scenes — so no other page ships it.
    import '@scripts/three-boot';
  </script>
</BaseLayout>
