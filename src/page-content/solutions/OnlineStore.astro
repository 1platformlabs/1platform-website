---
import LegacyOnlineStore from '@page-content/legacy/OnlineStore.astro';
import { infrastructureChrome } from '@lib/site-chrome';

import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import InteriorHero from '@components/InteriorHero.astro';
import Check from '@components/Check.astro';
import Icon from '@components/Icon.astro';
import type { IconName } from '@components/icons';
import { useI18n } from '@i18n';
import { siteOrigin } from '@lib/site-origin';
import { appUrl } from '@lib/site-destinations';
import storeImage from '@assets/product/showcase-store-bg.webp';
import paymentsImage from '@assets/product/showcase-payments-bg.webp';
import '@styles/photographic-interiors.css';
const { t, l } = useI18n(Astro.url.pathname, Astro.locals);
const title = infrastructureChrome(Astro.locals.messages) ? t('interiors.store.title') : '';
const description = infrastructureChrome(Astro.locals.messages) ? t('interiors.store.description') : '';
const storeUrl = appUrl(Astro.locals, 'store');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: t('nav.solutions.onlineStore'),
    provider: { '@type': 'Organization', name: t('org.legalName'), url: siteOrigin(Astro.locals) },
    description,
    url: new URL(l('/solutions/online-store/'), siteOrigin(Astro.locals)).toString(),
    areaServed: infrastructureChrome(Astro.locals.messages) ? t('interiors.store.jsonld.areaServed') : '',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: new URL(l('/'), siteOrigin(Astro.locals)).toString() },
      { '@type': 'ListItem', position: 2, name: t('nav.solutions'), item: new URL(l('/solutions/'), siteOrigin(Astro.locals)).toString() },
      { '@type': 'ListItem', position: 3, name: t('nav.solutions.onlineStore') },
    ],
  },
];


const features: { key: string; icon: IconName }[] = [
  { key: 'storefront', icon: 'storefront' }, { key: 'payments', icon: 'payment-card' },
  { key: 'invoicing', icon: 'receipt' }, { key: 'domain', icon: 'globe-meridian' },
];
const included = ['catalog', 'checkout', 'accounts', 'payments', 'webhooks', 'reconciliation', 'invoices', 'tax', 'domainReg', 'dns'];
const steps = ['domain', 'buildStore', 'collectionAccount', 'addProductsAndSell'];

const approvedInteriors = infrastructureChrome(Astro.locals.messages);
---
{approvedInteriors ? (
<BaseLayout title={title} description={description} ogImage="/og/solution-online-store.png" jsonLd={jsonLd} showAnnouncement={false}>
  <div class="photographic-interior">
    <InteriorHero variant="store" image={storeImage} kicker={t('interiors.store.hero.badge')} title={t('interiors.store.hero.headline')} description={t('interiors.store.hero.subheadline')}>
      <div class="hero-actions">
        {storeUrl && <a class="button button--white" href={storeUrl}>{t('interiors.open_store')}<Icon name="arrow-up-right" /></a>}
        <a class="button button--outline" href="#como-funciona">{t('interiors.see_how')}<Icon name="arrow-right-short" /></a>
      </div>
      <div slot="bottom" class="wrap hero-bottom"><p>{t('interiors.hero_foot')}</p><div class="hero-benefits"><span><Icon name="payment-card" />{t('interiors.foot_1')}</span><span><Icon name="storefront" />{t('interiors.foot_2')}</span><span><Icon name="receipt" />{t('interiors.foot_3')}</span></div></div>
    </InteriorHero>
    <section class="section" id="beneficios"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">{t('interiors.store.whatYouGet.eyebrow')}</p><h2 class="section-title">{t('interiors.store.whatYouGet.lead')}</h2></div><p>{t('interiors.benefit_lede')}</p></div>
      <div class="feature-grid">{features.map(({ key, icon }) => <article class="feature-card"><span class="feature-icon"><Icon name={icon} /></span><h3>{t(`interiors.store.feature.${key}.title`)}</h3><p>{t(`interiors.store.feature.${key}.desc`)}</p></article>)}</div>
    </div></section>
    <section class="story-section" id="incluido">
      <Image class="story-image" src={paymentsImage} alt="" widths={[640, 960, 1440]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" />
      <div class="story-copy"><p class="eyebrow">{t('interiors.store.inTheBox.eyebrow')}</p><h2>{t('interiors.store.inTheBox.title')}</h2><p>{t('interiors.store.inTheBox.desc')}</p><a class="button button--white" href="#lista-incluida">{t('interiors.included_cta')}<Icon name="arrow-right-short" /></a></div>
    </section>
    <section class="section section--wash" id="lista-incluida"><div class="wrap"><p class="eyebrow">{t('interiors.store.inTheBox.eyebrow')}</p><h2 class="section-title">{t('interiors.store.inTheBox.title')}</h2><ul class="included-list">{included.map((key) => <li><Check yes label={t('interiors.store.inTheBox.includedLabel')} /><span>{t(`interiors.store.included.${key}`)}</span></li>)}</ul></div></section>
    <section class="section section--navy" id="como-funciona"><div class="wrap"><p class="eyebrow">{t('interiors.store.howItWorks.eyebrow')}</p><h2 class="section-title">{t('interiors.store.howItWorks.lead')}</h2><p class="section-lede">{t('interiors.steps_lede')}</p><div class="steps" aria-label={t('interiors.store.howItWorks.aria')}>{steps.map((key, index) => <div class="step"><span class="step-number">0{index + 1}</span><h3>{t(`interiors.store.step.${key}`)}</h3><p>{t(`interiors.step.${index + 1}.description`)}</p></div>)}</div></div></section>
    <section class="section closing"><div class="wrap closing-inner"><div><p class="eyebrow">{t('interiors.store.next.eyebrow')}</p><h2>{t('interiors.store.next.title')}</h2><p class="section-lede">{t('interiors.store.next.desc')}</p></div>{storeUrl && <a class="button button--navy" href={storeUrl}>{t('interiors.open_store')}<Icon name="arrow-up-right" /></a>}</div></section>
  </div>
</BaseLayout>
) : (<LegacyOnlineStore />)}
