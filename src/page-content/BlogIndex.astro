---
import LegacyBlogIndex from '@page-content/legacy/BlogIndex.astro';
import { infrastructureChrome } from '@lib/site-chrome';

import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import InteriorHero from '@components/InteriorHero.astro';
import BlogPostCard from '@components/BlogPostCard.astro';
import Icon from '@components/Icon.astro';
import { useI18n, formatDate } from '@i18n';
import { bareSlug, getLocalized } from '@i18n/collections';
import { archiveSummary, displayHeading, editorialOrder } from '@lib/blog-presentation';
import { siteOrigin } from '@lib/site-origin';
import blogImage from '@assets/product/showcase-content-bg.webp';
import storeImage from '@assets/product/showcase-store-bg.webp';
import '@styles/photographic-interiors.css';
const { t, l, locale } = useI18n(Astro.url.pathname, Astro.locals);
const [lead, ...archive] = editorialOrder(await getLocalized('blog', locale));
const categories = [...new Set(archive.map((post) => post.data.category))];
const requestedCategory = Astro.url.searchParams.get('category');
const category = categories.find((value) => value === requestedCategory) ?? 'all';
const visibleCount = archive.filter((post) => category === 'all' || category === post.data.category).length;
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: new URL(l('/'), siteOrigin(Astro.locals)).href },
    { '@type': 'ListItem', position: 2, name: t('blog.h1'), item: new URL(l('/blog/'), siteOrigin(Astro.locals)).href },
  ],
};

const approvedInteriors = infrastructureChrome(Astro.locals.messages);
---
{approvedInteriors ? (
<BaseLayout title={t('blog.title')} description={t('blog.description')} jsonLd={breadcrumbs} showAnnouncement={false}>
  <div class="photographic-interior">
    <InteriorHero variant="blog" image={blogImage} kicker={t('interiors.blog_kicker')} title={t('blog.h1')} description={t('interiors.blog_lede')} />
    <section class="section" id="archivo"><div class="wrap">
      {lead && <a class="blog-feature" href={l(`/blog/${bareSlug(lead.id)}/`)}>
        <Image src={storeImage} alt="" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" />
        <div class="blog-feature-content">
          <p class="eyebrow">{t('interiors.latest')} · {t(`interiors.category.${lead.data.category}`)}</p>
          <h2>{displayHeading(lead.data.title)}</h2>
          <p>{displayHeading(archiveSummary(lead, locale))}</p>
          <span class="meta-line"><time datetime={lead.data.pubDate.toISOString()}>{formatDate(lead.data.pubDate, locale)}</time>{lead.data.readingTime && <> · {t('blog.readingTime', { n: lead.data.readingTime })}</>}</span>
          <span class="button button--white">{t('blog.readArticle')}<Icon name="arrow-up-right" size={18} /></span>
        </div>
      </a>}
      <div class="archive-layout" id="articulos" data-blog-archive data-count-one={t('interiors.count.one', { n: '__COUNT__' })} data-count-other={t('interiors.count.other', { n: '__COUNT__' })}>
        <aside class="archive-sidebar" aria-label={t('interiors.filter_label')}>
          <p class="eyebrow archive-topics">{t('interiors.topics')}</p>
          <div class="filters" role="group" aria-label={t('interiors.filter_label')}>
            <a class="filter" href={`${l('/blog/')}#articulos`} data-filter="all" aria-current={category === 'all' ? 'true' : undefined} aria-controls="archive-list">{t('interiors.all')}</a>
            {categories.map((value) => <a class="filter" href={`${l('/blog/')}?category=${value}#articulos`} data-filter={value} aria-current={category === value ? 'true' : undefined} aria-controls="archive-list">{t(`interiors.category.${value}`)}</a>)}
          </div>
          <form class="archive-mobile-filter" action={`${l('/blog/')}#articulos`} method="get">
            <label for="archive-topic">{t('interiors.topics')}</label>
            <select id="archive-topic" name="category" aria-controls="archive-list">
              <option value="all" selected={category === 'all'}>{t('interiors.all')}</option>
              {categories.map((value) => <option value={value} selected={category === value}>{t(`interiors.category.${value}`)}</option>)}
            </select>
            <noscript><button class="button button--navy" type="submit">{t('interiors.filter_label')}</button></noscript>
          </form>
        </aside>
        <div class="archive-content">
          <div class="archive-heading"><h2>{t('interiors.archive')}</h2><p class="filter-count" aria-live="polite" aria-atomic="true">{t(visibleCount === 1 ? 'interiors.count.one' : 'interiors.count.other', { n: visibleCount })}</p></div>
          <div class="archive-list" id="archive-list">{archive.map((post) => <BlogPostCard post={post} hidden={category !== 'all' && category !== post.data.category} />)}</div>
        </div>
      </div>
    </div></section>
    <section class="section closing"><div class="wrap closing-inner"><div><p class="eyebrow">{t('interiors.next_kicker')}</p><h2>{t('interiors.next_title')}</h2></div><a class="button button--navy" href={l('/solutions/online-store/')}>{t('nav.solutions.onlineStore')}<Icon name="arrow-right-short" /></a></div></section>
  </div>
</BaseLayout>
) : (<LegacyBlogIndex />)}
<script>
  import '@scripts/blog-archive';
</script>
