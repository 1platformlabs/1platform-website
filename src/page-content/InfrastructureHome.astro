---
import TenantBrand from '@components/TenantBrand.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useI18n } from '@i18n';
import { docsUrl, supportUrl } from '@lib/site-destinations';
import LandingReviews from '@components/LandingReviews.astro';
import { resolveSiteReviews } from '@lib/site-reviews';
import '@styles/infrastructure-home.css';

const { t } = useI18n(Astro.url.pathname, Astro.locals);
const tenant = Astro.locals.tenant;
const contactHref = supportUrl(Astro.locals);
const documentationHref = docsUrl(Astro.locals, '/docs/saas/1platform-api/getting-started/');
// landing-reviews-tenant: null = no section (switched off, API silent, repo mode).
const reviews = await resolveSiteReviews(tenant.slug);
const locale = Astro.locals.locale;
const formatLocale = tenant.region ? `${locale}-${tenant.region}` : locale;
---
<BaseLayout title={t('infrastructure.meta.title')} description={t('infrastructure.meta.description')} showAnnouncement={false}>
<div class="infrastructure-home" data-infrastructure-home
  data-selection-empty={t('infrastructure.selection.empty')}
  data-selection-one={t('infrastructure.selection.one')}
  data-selection-many={t('infrastructure.selection.many')}
  data-ai-enabled={t('infrastructure.intelligence.enabled')}
  data-ai-disabled={t('infrastructure.intelligence.toggle')}>
<svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <symbol id="infra-i-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" /></symbol>
      <symbol id="infra-i-up" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12" /></symbol>
      <symbol id="infra-i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
      <symbol id="infra-i-stack" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="5" rx="1" /><rect x="3" y="10" width="18" height="5" rx="1" /><rect x="3" y="17" width="18" height="5" rx="1" /></symbol>
      <symbol id="infra-i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></symbol>
      <symbol id="infra-i-spark" viewBox="0 0 24 24"><path d="m12 2 1.9 7.1L21 11l-7.1 1.9L12 20l-1.9-7.1L3 11l7.1-1.9L12 2Zm7 16 .8 2.2L22 21l-2.2.8L19 24l-.8-2.2L16 21l2.2-.8L19 18Z" /></symbol>
    </svg>
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-shade"></div>
        <div class="hero-pulse" aria-hidden="true">
          <svg viewBox="0 0 1400 800" preserveAspectRatio="none">
            <defs><linearGradient id="hero-wire-color"><stop class="hero-stop-0" stop-opacity="0"/><stop offset=".35" class="hero-stop-1"/><stop offset=".8" class="hero-stop-2"/><stop offset="1" class="hero-stop-3" stop-opacity="0"/></linearGradient></defs>
            <path class="hero-wire" d="M630 840C760 590 1130 790 1170 430S1350 170 1490 60"/>
            <path class="hero-wire hero-wire--second" d="M580 850C710 600 1080 800 1120 440S1300 180 1440 70"/>
            <path class="hero-wire hero-wire--third" d="M680 860C810 610 1180 800 1220 440S1400 180 1540 70"/>
            <path class="hero-wire-travel" pathLength="1000" d="M630 840C760 590 1130 790 1170 430S1350 170 1490 60"/>
            <path class="hero-wire-travel hero-wire-travel--second" pathLength="1000" d="M580 850C710 600 1080 800 1120 440S1300 180 1440 70"/>
            <path class="hero-wire-travel hero-wire-travel--third" pathLength="1000" d="M680 860C810 610 1180 800 1220 440S1400 180 1540 70"/>
          </svg>
        </div>
        <div class="hero-content">
          <p class="hero-kicker">{t('infrastructure.hero.kicker')}</p>
          <h1 id="hero-title">{t('infrastructure.hero.title')}<br /><span>{t('infrastructure.hero.titleEmphasis')}</span></h1>
          <p class="hero-lede">{t('infrastructure.hero.description')}</p>
          <div class="hero-actions">
            <a class="button button--white" href="#capacidades">{t('infrastructure.hero.explore')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>
            {contactHref && (<a class="button button--outline" href={contactHref}>{t('infrastructure.contact.cta')}<svg class="icon" aria-hidden="true"><use href="#infra-i-up" /></svg></a>)}
          </div>
        </div>
        <div class="wrap hero-bottom">
          <p>{t('infrastructure.hero.caption')}</p>
          <div class="hero-benefits"><span><svg class="icon" aria-hidden="true"><use href="#infra-i-stack" /></svg>{t('infrastructure.hero.services')}</span><span><svg class="icon" aria-hidden="true"><use href="#infra-i-grid" /></svg>{t('infrastructure.hero.brand')}</span><span><svg class="icon" aria-hidden="true"><use href="#infra-i-spark" /></svg>{t('infrastructure.hero.ai')}</span></div>
        </div>
      </section>

      <section class="section premise" id="propuesta" aria-labelledby="premise-title">
        <div class="wrap premise-grid">
          <div><p class="eyebrow">{t('infrastructure.premise.eyebrow')}</p><h2 id="premise-title">{t('infrastructure.premise.title')}</h2></div>
          <div class="premise-aside"><p>{t('infrastructure.premise.description')}</p><a class="text-link" href="#arquitectura">{t('infrastructure.premise.link')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a></div>
        </div>
        <div class="wrap outcome-grid" aria-label={t('infrastructure.aria.outcomes')}>
          <article><span>{t('infrastructure.outcome.create.eyebrow')}</span><h3>{t('infrastructure.outcome.create.title')}</h3><p>{t('infrastructure.outcome.create.description')}</p></article>
          <article><span>{t('infrastructure.outcome.connect.eyebrow')}</span><h3>{t('infrastructure.outcome.connect.title')}</h3><p>{t('infrastructure.outcome.connect.description')}</p></article>
          <article><span>{t('infrastructure.outcome.ai.eyebrow')}</span><h3>{t('infrastructure.outcome.ai.title')}</h3><p>{t('infrastructure.outcome.ai.description')}</p></article>
        </div>
      </section>

      <section class="section capabilities" id="capacidades" aria-labelledby="capabilities-title">
        <div class="wrap section-heading"><div><p class="eyebrow">{t('infrastructure.capabilities.eyebrow')}</p><h2 id="capabilities-title">{t('infrastructure.capabilities.title')}</h2></div><p>{t('infrastructure.capabilities.description')}</p></div>
        <div class="wrap capability-layout">
          <div class="capability-grid" aria-label={t('infrastructure.aria.capabilities')}>
            <div class="capability-entry">
            <button class="capability is-selected" type="button" data-capability={t('infrastructure.capabilities.payments.name')} aria-pressed="true"><span class="capability-number">01</span><span class="capability-text"><strong>{t('infrastructure.capabilities.payments.name')}</strong><small>{t('infrastructure.capabilities.payments.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/pagos-en-linea/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/pagos-en-linea/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.payments.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability is-selected" type="button" data-capability={t('infrastructure.capabilities.invoicing.name')} aria-pressed="true"><span class="capability-number">02</span><span class="capability-text"><strong>{t('infrastructure.capabilities.invoicing.name')}</strong><small>{t('infrastructure.capabilities.invoicing.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/facturacion-electronica/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/facturacion-electronica/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.invoicing.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability is-selected" type="button" data-capability={t('infrastructure.capabilities.delivery.name')} aria-pressed="true"><span class="capability-number">03</span><span class="capability-text"><strong>{t('infrastructure.capabilities.delivery.name')}</strong><small>{t('infrastructure.capabilities.delivery.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/envios/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/envios/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.delivery.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.subscriptions.name')} aria-pressed="false"><span class="capability-number">04</span><span class="capability-text"><strong>{t('infrastructure.capabilities.subscriptions.name')}</strong><small>{t('infrastructure.capabilities.subscriptions.description')}</small><em>{t('infrastructure.capabilities.subscriptions.status')}</em></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/suscripciones/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/suscripciones/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.subscriptions.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.ads.name')} aria-pressed="false"><span class="capability-number">05</span><span class="capability-text"><strong>{t('infrastructure.capabilities.ads.name')}</strong><small>{t('infrastructure.capabilities.ads.description')}</small><em>{t('infrastructure.capabilities.ads.status')}</em></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/publicidad/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/publicidad/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.ads.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.sites.name')} aria-pressed="false"><span class="capability-number">06</span><span class="capability-text"><strong>{t('infrastructure.capabilities.sites.name')}</strong><small>{t('infrastructure.capabilities.sites.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/sitios-web-y-contenido/publicar-con-dominio/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/sitios-web-y-contenido/publicar-con-dominio/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.sites.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.email.name')} aria-pressed="false"><span class="capability-number">07</span><span class="capability-text"><strong>{t('infrastructure.capabilities.email.name')}</strong><small>{t('infrastructure.capabilities.email.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/dominios-y-correo/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/dominios-y-correo/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.email.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.agents.name')} aria-pressed="false"><span class="capability-number">08</span><span class="capability-text"><strong>{t('infrastructure.capabilities.agents.name')}</strong><small>{t('infrastructure.capabilities.agents.description')}</small><em>{t('infrastructure.capabilities.agents.status')}</em></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/agentes-de-ia/integrar-en-su-aplicacion/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/agentes-de-ia/integrar-en-su-aplicacion/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.agents.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.telemetry.name')} aria-pressed="false"><span class="capability-number">09</span><span class="capability-text"><strong>{t('infrastructure.capabilities.telemetry.name')}</strong><small>{t('infrastructure.capabilities.telemetry.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/telemetria/integrar-telemetria/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/telemetria/integrar-telemetria/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.telemetry.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
            <div class="capability-entry">
            <button class="capability" type="button" data-capability={t('infrastructure.capabilities.whitelabel.name')} aria-pressed="false"><span class="capability-number">10</span><span class="capability-text"><strong>{t('infrastructure.capabilities.whitelabel.name')}</strong><small>{t('infrastructure.capabilities.whitelabel.description')}</small></span><span class="capability-indicator" aria-hidden="true">+</span></button>
              {docsUrl(Astro.locals, '/docs/saas/1platform-api/plataforma/marca-blanca/') && (<a class="capability-documentation" href={docsUrl(Astro.locals, '/docs/saas/1platform-api/plataforma/marca-blanca/')} aria-label={t('infrastructure.capabilities.documentation') + ": " + t('infrastructure.capabilities.whitelabel.name')}>{t('infrastructure.capabilities.documentation')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}
            </div>
          </div>
          <div class="integration-preview" aria-labelledby="integration-title">
            <p class="integration-kicker">{t('infrastructure.integration.eyebrow')}</p>
            <div class="integration-source"><h3 id="integration-title">{t('infrastructure.integration.title')}</h3><div class="integration-clients"><span>{t('infrastructure.integration.saas')}</span><span>{t('infrastructure.integration.applications')}</span><span>{t('infrastructure.integration.erp')}</span></div></div>
            <div class="integration-bridge"><span>{t('infrastructure.integration.bridge')}</span></div>
            <div class="integration-core"><span class="integration-logo" aria-hidden="true"><TenantBrand variant="symbol">{tenant.brand_mark ?? tenant.brand_name}</TenantBrand></span><div><strong>{tenant.brand_name}</strong><small>{t('infrastructure.integration.description')}</small></div></div>
            <div class="integration-branch" aria-hidden="true"></div>
            <p class="integration-services-label">{t('infrastructure.integration.services')}</p>
            <ul class="selected-list" data-selected-list><li>{t('infrastructure.capabilities.payments.name')}</li><li>{t('infrastructure.capabilities.invoicing.name')}</li><li>{t('infrastructure.capabilities.delivery.name')}</li></ul>
            <p class="selection-count" data-selection-count aria-live="polite">{t('infrastructure.integration.initialCount')}</p>
            <p class="preview-note">{t('infrastructure.integration.note')}</p>
          </div>
        </div>
      </section>

      <section class="section payments" id="pagos" aria-labelledby="payments-title">
        <div class="wrap payments-heading">
          <div><p class="eyebrow">{t('infrastructure.payments.eyebrow')}</p><h2 id="payments-title">{t('infrastructure.payments.title')}</h2></div>
          <p>{t('infrastructure.payments.description')}</p>
        </div>
        <div class="wrap payment-grid">
          <article class="payment-card"><span class="payment-index">{t('infrastructure.payments.links.status')}</span><h3>{t('infrastructure.payments.links.title')}</h3><p>{t('infrastructure.payments.links.description')}</p></article>
          <article class="payment-card"><span class="payment-index">{t('infrastructure.payments.phone.status')}</span><h3>{t('infrastructure.payments.phone.title')}</h3><p>{t('infrastructure.payments.phone.description')}</p></article>
          <article class="payment-card"><span class="payment-index">{t('infrastructure.payments.subscriptions.status')}</span><h3>{t('infrastructure.capabilities.subscriptions.name')}</h3><p>{t('infrastructure.payments.subscriptions.description')}</p></article>
        </div>
      </section>

      <section class="section connected" id="flujo" aria-labelledby="connected-title">
        <div class="wrap connected-layout">
          <div class="connected-copy">
            <p class="eyebrow">{t('infrastructure.connected.eyebrow')}</p>
            <h2 id="connected-title">{t('infrastructure.connected.title')}</h2>
            <p>{t('infrastructure.connected.description')}</p>
            <div class="sales-concept"><span>{t('infrastructure.connected.vision.status')}</span><strong>{t('infrastructure.connected.vision.title')}</strong><p>{t('infrastructure.connected.vision.description')}</p></div>
          </div>
          <ol class="connected-flow" aria-label={t('infrastructure.aria.flow')}>
            <li><span>01</span><div><strong>{t('infrastructure.capabilities.ads.name')}</strong><small>{t('infrastructure.connected.advertising')}</small></div></li>
            <li><span>02</span><div><strong>{t('infrastructure.connected.agent')}</strong><small>{t('infrastructure.connected.offer')}</small></div></li>
            <li><span>03</span><div><strong>{t('infrastructure.connected.payment')}</strong><small>{t('infrastructure.connected.paymentDescription')}</small></div></li>
            <li><span>04</span><div><strong>{t('infrastructure.capabilities.invoicing.name')}</strong><small>{t('infrastructure.connected.invoice')}</small></div></li>
            <li><span>05</span><div><strong>{t('infrastructure.capabilities.delivery.name')}</strong><small>{t('infrastructure.connected.delivery')}</small></div></li>
          </ol>
        </div>
        <p class="wrap connected-note">{t('infrastructure.connected.note')}</p>
      </section>

      <section class="section architecture" id="arquitectura" aria-labelledby="architecture-title">
        <div class="wrap"><p class="eyebrow">{t('infrastructure.hero.kicker')}</p><div class="architecture-heading"><h2 id="architecture-title">{t('infrastructure.architecture.title')}<br />{t('infrastructure.architecture.titleEmphasis')}</h2><p>{t('infrastructure.architecture.description')}</p></div>
          <div class="layer-grid">
            <article class="layer-card layer-card--infrastructure"><span class="layer-index">{t('infrastructure.architecture.services')}</span><div class="layer-graphic" aria-hidden="true"><span>{t('infrastructure.architecture.api')}</span><i></i><span>{t('infrastructure.architecture.payments')}</span><i></i><span>{t('infrastructure.architecture.delivery')}</span><i></i><span>{t('infrastructure.architecture.ai')}</span></div><h3>{t('infrastructure.architecture.apiName')}</h3><p>{t('infrastructure.architecture.apiDescription')}</p>{documentationHref && (<a href={documentationHref}>{t('infrastructure.architecture.apiLink')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}</article>
            <article class="layer-card layer-card--ecosystem"><span class="layer-index">{t('infrastructure.architecture.applications')}</span><div class="layer-ecosystem" aria-hidden="true"><span>{t('infrastructure.integration.saas')}</span><span>{t('infrastructure.integration.erp')}</span><span>{t('infrastructure.integration.applications')}</span></div><h3>{t('infrastructure.architecture.titleEmphasis')}</h3><p>{t('infrastructure.architecture.ecosystemDescription')}</p>{contactHref && (<a href={contactHref}>{t('infrastructure.architecture.contact')}<svg class="icon" aria-hidden="true"><use href="#infra-i-arrow" /></svg></a>)}</article>
          </div>
          <p class="architecture-note"><svg class="icon" aria-hidden="true"><use href="#infra-i-grid" /></svg><span>{t('infrastructure.architecture.note')}</span></p>
        </div>
      </section>

      <section class="intelligence" id="inteligencia" aria-labelledby="intelligence-title">
        <div class="agent-blueprint" aria-label={t('infrastructure.aria.agent')}>
          <p class="eyebrow">{t('infrastructure.intelligence.eyebrow')}</p>
          <div class="agent-product"><span class="agent-product-label">{t('infrastructure.intelligence.application')}</span><strong>{t('infrastructure.intelligence.request')}</strong></div>
          <div class="agent-connector" aria-hidden="true"></div>
          <div class="agent-node"><svg class="icon" aria-hidden="true"><use href="#infra-i-spark" /></svg><h3>{t('infrastructure.intelligence.agent')}</h3><p>{t('infrastructure.intelligence.context')}</p></div>
          <div class="agent-connector" aria-hidden="true"></div>
          <div class="agent-tools"><span>{t('infrastructure.intelligence.conversation')}</span><span>{t('infrastructure.intelligence.offer')}</span><span>{t('infrastructure.connected.payment')}</span></div>
          <p class="agent-blueprint-note">{t('infrastructure.intelligence.brand')}</p>
        </div>
        <div class="intelligence-copy">
          <p class="eyebrow">{t('infrastructure.intelligence.pace')}</p>
          <h2 id="intelligence-title">{t('infrastructure.intelligence.title')}</h2>
          <p>{t('infrastructure.intelligence.description')}</p>
          <div class="ai-demo" data-ai-demo>
            <div class="ai-demo-top"><span>{t('infrastructure.intelligence.vision')}</span><button class="ai-switch" type="button" data-ai-switch aria-pressed="false" aria-controls="ai-preview"><span class="ai-switch-track" aria-hidden="true"></span><span data-ai-switch-label>{t('infrastructure.intelligence.toggle')}</span></button></div>
            <div class="ai-preview" id="ai-preview" aria-live="polite">
              <div><span>{t('infrastructure.intelligence.experience')}</span><p data-ai-base={t('infrastructure.intelligence.experienceBase')} data-ai-on={t('infrastructure.intelligence.experienceOn')}>{t('infrastructure.intelligence.experienceBase')}</p></div>
              <div><span>{t('infrastructure.architecture.payments')}</span><p data-ai-base={t('infrastructure.intelligence.paymentsBase')} data-ai-on={t('infrastructure.intelligence.paymentsOn')}>{t('infrastructure.intelligence.paymentsBase')}</p></div>
              <div><span>{t('infrastructure.intelligence.operations')}</span><p data-ai-base={t('infrastructure.intelligence.operationsBase')} data-ai-on={t('infrastructure.intelligence.operationsOn')}>{t('infrastructure.intelligence.operationsBase')}</p></div>
            </div>
          </div>
          <p class="ai-demo-note">{t('infrastructure.intelligence.note')}</p>
        </div>
      </section>

      <section class="section developers" id="desarrolladores" aria-labelledby="developers-title"><div class="wrap developers-inner"><div><p class="eyebrow">{t('infrastructure.developers.eyebrow')}</p><h2 id="developers-title">{t('infrastructure.developers.title')}</h2><p>{t('infrastructure.developers.description')}</p>{documentationHref && (<a class="button button--white" href={documentationHref}>{t('infrastructure.developers.link')}<svg class="icon" aria-hidden="true"><use href="#infra-i-up" /></svg></a>)}</div><div class="developer-visual" aria-label={t('infrastructure.aria.developer')}><span>{t('infrastructure.developers.product')}</span><div class="developer-flow"><span></span><span></span><span></span></div><strong>{t('infrastructure.architecture.apiName')}</strong><small>{t('infrastructure.developers.capabilities')}</small></div></div></section>

      {reviews && <LandingReviews reviews={reviews} locale={locale} formatLocale={formatLocale} />}

      <section class="section contact" id="contacto" aria-labelledby="contact-title"><div class="wrap contact-inner"><div><p class="eyebrow">{t('infrastructure.contact.eyebrow')}</p><h2 id="contact-title">{t('infrastructure.contact.title')}</h2><p>{t('infrastructure.contact.description')}</p></div>{contactHref && (<a class="button button--navy" href={contactHref}>{t('infrastructure.contact.whatsapp')}<svg class="icon" aria-hidden="true"><use href="#infra-i-up" /></svg></a>)}</div></section>

</div>
</BaseLayout>
