---
import { ClientRouter } from 'astro:transitions';
import AnnouncementBar from '@components/AnnouncementBar.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { pickAnnouncement } from '@components/announcement';
import { OG_LOCALES, alternatesForPath, useI18n, type Locale } from '@i18n';
import { getLocalized } from '@i18n/collections';
import { localizedOgImage } from '@i18n/og';
import '@styles/global.css';
import '@styles/components.css';
import { siteOrigin } from '@lib/site-origin';
import { themeDeclarations } from '@lib/tenant-theme';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The home uses a deliberately quiet opening composition. Other routes keep
   * the current-release strip in the shared chrome. */
  showAnnouncement?: boolean;
  /**
   * Path per locale. Defaults to "the same slug in both languages", which is
   * true for every marketing page. Content pages whose twin may not exist pass
   * their own map and omit what is missing.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  noIndex = false,
  jsonLd,
  showAnnouncement = true,
  alternates = alternatesForPath(Astro.url.pathname),
} = Astro.props;

const { locale, t, l } = useI18n(Astro.url.pathname, Astro.locals);

const tenant = Astro.locals.tenant;

/**
 * Whether crawlers are welcome — the TENANT's answer, not just the page's.
 *
 * `noIndex` was a prop with a default of `false` and, measured, ZERO callers in
 * the entire tree. So `indexable: false` on a manifest blocked exactly one
 * thing (the sitemap answered 404) while every page of that tenant was served
 * without a robots meta and remained perfectly crawlable. The comment in
 * `src/data/site-tenants.ts` asserting that it "puts noindex on every page" was
 * simply false, and reading the comment instead of the code is how a
 * provisional domain gets indexed.
 *
 * The page-level prop is kept and ORed rather than replaced: a page may have
 * its own reason to stay out of the index, and a tenant-level `false` must not
 * be able to overrule it.
 */
const noIndexEffective = noIndex || !tenant.indexable;

/**
 * JSON for a `<script>` block, which is NOT the same as JSON.
 *
 * `set:html` turns OFF Astro's escaping on purpose, and `JSON.stringify` does
 * not escape `<` — so a brand containing `</script>` closes the block early and
 * everything after it is parsed as markup. With the brand now coming from the
 * manifest, that string is operator-supplied and lands directly here.
 *
 * `<` and `>` become their unicode escapes, which JSON parsers read as the same
 * characters and an HTML parser cannot see. `&` goes too, so the payload cannot
 * be reassembled through entity decoding.
 *
 * Note this is specific to `set:html`. The `{title}` interpolation and the
 * `<meta content=...>` attributes below DO go through Astro's escaper and are
 * already safe — verified, and worth saying so nobody "hardens" them into
 * double-escaped mojibake.
 */
const jsonLdScript = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');

const canonicalURL = new URL(Astro.url.pathname, siteOrigin(Astro.locals));
// The share card follows the page's language. A Spanish page pointing at an
// English card was issue #59: the headline of the card is the reader's first
// contact with the product, and it arrived in a language they did not pick.
// Cards with nothing to translate (the wordmark fallback) are left alone —
// `localizedOgImage` only swaps names it knows were drawn in that language.
const ogImageURL = new URL(localizedOgImage(ogImage, locale), siteOrigin(Astro.locals));

// hreflang must be absolute, and reciprocal: if English names Spanish, Spanish
// has to name English with the identical pair, or Google discards the whole
// annotation. Emitting both from one map is what guarantees that.
//
// The block is rendered BEFORE the detection script, and that order is
// load-bearing: the script picks where to send a first-time visitor by reading
// the hreflang="es" link out of this very document. Scripts run as they are
// parsed, so with the script first these links would not exist yet, the lookup
// would return null, the guard would bail every time, and auto-detection would
// silently never fire.
const alternateLinks = (Object.entries(alternates) as [Locale, string][]).map(
  ([code, path]) => ({ code, href: new URL(path, siteOrigin(Astro.locals)).toString() }),
);

// x-default points at the unprefixed English URL: it is the already-indexed
// canonical, and pointing it at /es/ would have Google serve Spanish to en-AU
// and en-CA readers — exactly what the language rule says must not happen.
const xDefault = alternates.en ? new URL(alternates.en, siteOrigin(Astro.locals)).toString() : null;

// The feed follows the section it describes. A tenant that does not publish a
// blog has no feed — `/rss.xml` answers 404 for it by design — so advertising
// one in every page's <head> pointed readers and crawlers at nothing.
const rssPath = tenant.pages.includes('/blog/') ? l('/rss.xml') : null;

// The announcement bar shows the newest changelog entry of this language, or
// nothing at all (D-9). The layout decides here, because the bar's 40 px move
// the fixed header and every offset under it: `has-announcement` on <html>
// sets `--header-top`, and `--header-offset` (global.css) follows.
//
// ⚠️ Y SÓLO SI ESTE INQUILINO PUBLICA EL CHANGELOG — misma regla que `rssPath`
// dos líneas arriba, y por el mismo motivo. La tira lee la colección del REPO,
// que es el changelog de 1Platform: sin este filtro, la novedad de producto de
// la plataforma —su texto, su voz— se dibujaba dentro del cromo de un
// inquilino, enlazando a una ruta que ese inquilino no publica y que por lo
// tanto contesta 404. Medido en el 404 de la clínica.
//
// El barrido de marca no puede verlo: el título de una entrada del changelog
// no tiene por qué contener la palabra «1Platform» — el de la entrada vigente
// no la tiene.
// El tema del inquilino, para ESTA petición. Ver `src/lib/tenant-theme.ts`:
// el manifiesto ya traía `theme` validado y nadie lo leía, así que todos los
// inquilinos se dibujaban con el cobalto de 1Platform.
const themeCss = themeDeclarations(tenant);

const publishesChangelog = tenant.pages.includes('/changelog/');
const changelog = publishesChangelog ? await getLocalized('changelog', locale) : [];
const announcement = pickAnnouncement(
  changelog.map((entry) => ({ title: entry.data.title, date: entry.data.date })),
);
const visibleAnnouncement = showAnnouncement ? announcement : null;
---

<!doctype html>
<html lang={locale} class:list={[visibleAnnouncement && 'has-announcement']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Self-hosted display + text faces; the rest load on demand with swap. -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Editorial display face used by the public site. -->
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo-oauth-120x120.png" />
    <link rel="canonical" href={canonicalURL} />
    {/* Not advertised by a tenant whose sitemap answers 404: every page of a
        non-indexable site used to announce a sitemap that does not exist. */}
    {tenant.indexable && <link rel="sitemap" href="/sitemap-index.xml" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    {noIndexEffective && <meta name="robots" content="noindex, nofollow" />}

    <!-- Language alternates -->
    {alternateLinks.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <script is:inline>
      /*
        First-visit language selection.

        Runs inline and blocking on purpose: deferring it would paint English
        first and then jump, which is worse than the few hundred bytes it costs.

        Every exit below is a rule, in priority order:
          1. an explicit choice always wins over a guess;
          2. a Spanish URL is never redirected — a shared link outranks the
             browser, and Google renders JS as en-US, so redirecting /es/ would
             put the whole Spanish tree at risk of deindexing;
          3. English browsers stay put;
          4. no translation declared means nowhere to go, so nothing happens.
      */
      (function () {
        if (window.__1pLangChecked) return;
        window.__1pLangChecked = true;

        var path = location.pathname;

        /*
          Rule 2 first: a Spanish URL is never redirected, whatever anyone
          prefers. Lower-cased only for this comparison, because an origin that
          treats paths case-insensitively can serve the Spanish tree at /ES/,
          and an English reader landing there must not be stranded in Spanish
          by a guard that failed to recognise the path.
        */
        var lower = path.toLowerCase();
        if (lower === '/es' || lower.indexOf('/es/') === 0) return;

        /*
          Rule 1: read the choice, do not merely notice one was made.

          Testing the cookie for presence rather than value inverted this
          entirely: choosing "Español" wrote 1p_lang=es, which suppressed the
          redirect, which meant the only way to be shown Spanish was to have
          expressed no preference at all. Anything that is not one of the two
          known values is treated as no preference, so a stale or truncated
          cookie degrades to detection instead of pinning someone to English
          with no way back except finding the control.
        */
        var match = /(?:^|;\s*)1p_lang=([^;]*)/.exec(document.cookie);
        var choice = match ? decodeURIComponent(match[1]).trim().toLowerCase() : '';
        if (choice !== 'en' && choice !== 'es') choice = '';

        var wanted;
        if (choice) {
          wanted = choice;
        } else {
          /*
            An absent locale is not a language. A headless renderer or a crawler
            that sets no `navigator.language` is unknown, not "not English", and
            treating unknown as Spanish pulls every such agent off the English
            tree — the same deindexing risk rule 2 protects the Spanish tree
            from, pointed the other way.
          */
          var tag = navigator.language || '';
          if (!tag) return;
          wanted = tag.toLowerCase().split('-')[0] === 'en' ? 'en' : 'es';
        }

        if (wanted === 'en') return;

        var alt = document.querySelector('link[rel="alternate"][hreflang="es"]');
        if (!alt) return;

        /*
          Navigate by PATH, not by the link's href. The href is absolute against
          the production origin, so reusing it verbatim would bounce anyone on
          localhost or a preview host straight to the live site — including the
          test suite, which would then be asserting against production.
        */
        var target = new URL(alt.getAttribute('href'), location.origin);
        if (target.pathname === path) return;

        location.replace(target.pathname + location.search + location.hash);
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={tenant.brand_name} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {(Object.keys(alternates) as Locale[])
      .filter((code) => code !== locale)
      .map((code) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
      ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {rssPath && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={t('layout.rssTitle')}
        href={rssPath}
      />
    )}

    <ClientRouter />

    {jsonLd && (
      <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />
    )}

    {/*
      The organisation is the TENANT, not the platform. This block used to be an
      inline literal naming 1Platform and its apex on every page — which under N
      brands means every client's site telling search engines it belongs to us.
      It goes through the same escaper as the block above for the same reason.
    */}
    <script type="application/ld+json" set:html={jsonLdScript({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: tenant.brand_name,
      // No trailing slash: this is an ORIGIN, and the literal it replaced did not
      // carry one either. Matching it keeps the page byte-identical to the frozen
      // baseline, which is what makes 'no regression' a measurement instead of a
      // judgement call.
      url: `https://${tenant.domain}`,
      // The favicon is still a file in public/, so it is still the platform's
      // drawing — but the URL must at least be the TENANT's origin, or this
      // block tells a search engine the client's logo is hosted by us. Serving
      // a per-tenant icon is D-17 work (public/ files become routes).
      logo: `https://${tenant.domain}/favicon.svg`,
    })} />

    {/*
      Los tokens del inquilino van AL FINAL del <head>, después de las hojas de
      estilo, y eso es deliberado: `global.css` declara los mismos nombres en
      `:root`, así que con igual especificidad gana el que se declara último.
      Subir la especificidad (`html:root`) habría funcionado también y habría
      dejado una regla que nadie puede sobrescribir después.

      `set:html` apaga el escapado de Astro. Es seguro porque el contenido no es
      texto libre: `themeDeclarations` sólo emite colores que casan `#` + 6
      dígitos hex y fuentes de un enum cerrado, y descarta todo lo demás.
    */}
    {themeCss && <style set:html={themeCss} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('layout.skipToContent')}</a>
    {visibleAnnouncement && <AnnouncementBar entry={visibleAnnouncement} />}
    <Header alternates={alternates} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import '@scripts/lenis-init';
      import '@scripts/animations';
    </script>
  </body>
</html>
