---
import LegacyBlogLayout from './LegacyBlogLayout.astro';
import { infrastructureChrome } from '@lib/site-chrome';

import BaseLayout from './BaseLayout.astro';
import TOC from '@components/TOC.astro';
import RelatedPosts from '@components/RelatedPosts.astro';
import InteriorHero from '@components/InteriorHero.astro';
import blogImage from '@assets/product/showcase-content-bg.webp';
import Icon from '@components/Icon.astro';
import '@styles/photographic-interiors.css';
import { formatDate, useI18n, type Locale } from '@i18n';
import { localizedOgImage } from '@i18n/og';
import { siteOrigin } from '@lib/site-origin';
import { resolveLogo } from '@lib/tenant-brand-assets';
import { socialLinksOf } from '@lib/social-links';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    category: string;
    image?: string;
    ogImage?: string;
    readingTime?: number;
    tags?: string[];
  };
  headings?: { depth: number; slug: string; text: string }[];
  slug: string;
  /** Omitting a locale here is how a post with no twin declares that. */
  alternates?: Partial<Record<Locale, string>>;
}

const { frontmatter, headings = [], slug, alternates } = Astro.props;
const { t, l, locale } = useI18n(Astro.url.pathname, Astro.locals);

const categoryLabel = infrastructureChrome(Astro.locals.messages) ? t(`interiors.category.${frontmatter.category}`) : '';
const brandName = Astro.locals.tenant.brand_name;
const tenantLogo = await resolveLogo(Astro.locals.tenant);
const sameAs = socialLinksOf(Astro.locals.tenant).map((link) => link.href);

// Built from the page's own locale so the canonical, the share URL and the
// Article @id all point at the language being read. These used to be pinned to
// the English origin, so a Spanish post advertised the English URL as its
// canonical identity.
const postPath = l(`/blog/${slug}/`);
const postURL = new URL(postPath, siteOrigin(Astro.locals)).href;

/** Only worth showing when it actually says something new. */
const showUpdated =
  frontmatter.updatedDate &&
  frontmatter.updatedDate.valueOf() !== frontmatter.pubDate.valueOf();

const ogImage = frontmatter.ogImage || frontmatter.image || '/og/default.png';
// Same swap as BaseLayout, and it has to happen here too: this URL is what
// goes into the Article JSON-LD `image`, which search engines read separately
// from the `og:image` meta. Leaving one of the two in English would make the
// page describe itself in two languages at once.
const ogImageURL = new URL(localizedOgImage(ogImage, locale), siteOrigin(Astro.locals)).href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: ogImageURL,
  author: {
    '@type': 'Person',
    name: frontmatter.author,
  },
  datePublished: frontmatter.pubDate.toISOString(),
  dateModified: (frontmatter.updatedDate || frontmatter.pubDate).toISOString(),
  // ⚠️ THE SECOND Organization BLOCK. `BaseLayout` has one too, and only that
  // one was made tenant-aware — so a blog post kept publishing the platform's
  // name, domain and logo under a client's domain long after the home page
  // stopped. It is the reason a post left 27 brand mentions against the home
  // page's 13, and a sweep for `Astro.site` never found it: every value here
  // was a literal.
  publisher: {
    '@type': 'Organization',
    name: brandName,
    url: siteOrigin(Astro.locals),
    ...(tenantLogo
      ? {
          logo: {
            '@type': 'ImageObject',
            url: new URL(tenantLogo, siteOrigin(Astro.locals)).href,
          },
        }
      : {}),
    // The same list the footer draws (D-7); absent — not `[]` — without links.
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
  inLanguage: locale,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postURL,
  },
};

const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: new URL(l('/'), siteOrigin(Astro.locals)).href },
    { '@type': 'ListItem', position: 2, name: t('blog.h1'), item: new URL(l('/blog/'), siteOrigin(Astro.locals)).href },
    { '@type': 'ListItem', position: 3, name: frontmatter.title, item: postURL },
  ],
};

const approvedInteriors = infrastructureChrome(Astro.locals.messages);
---
{approvedInteriors ? (
<BaseLayout
  title={t('blog.post.title', { title: frontmatter.title })}
  description={frontmatter.description}
  ogImage={frontmatter.ogImage}
  jsonLd={[articleJsonLd, breadcrumbs]}
  alternates={alternates}
  showAnnouncement={false}
>
  <div class="photographic-interior">
    <InteriorHero variant="article" image={blogImage} kicker={t('interiors.blog_kicker')} title={frontmatter.title} description={frontmatter.description}>
      <div class="article-hero-meta">
        <span>{categoryLabel}</span>
        <span><time datetime={frontmatter.pubDate.toISOString()}>{formatDate(frontmatter.pubDate, locale)}</time></span>
        {frontmatter.readingTime && <span>{t('blog.readingTime', { n: frontmatter.readingTime })}</span>}
        {showUpdated && frontmatter.updatedDate && <span>{t('blog.updated')} <time datetime={frontmatter.updatedDate.toISOString()}>{formatDate(frontmatter.updatedDate, locale)}</time></span>}
      </div>
    </InteriorHero>
    <div class="wrap article-layout">
      <TOC headings={headings} photographic title={t('interiors.toc')} />
      <article class="article-copy">
        <slot />
        <div class="article-end"><a class="button button--light" href={l('/blog/')}><Icon name="arrow-right-short" />{t('interiors.back_blog')}</a>{frontmatter.readingTime && <span>{t('blog.readingTime', { n: frontmatter.readingTime })}</span>}</div>
      </article>
    </div>
    <RelatedPosts currentSlug={slug} currentCategory={frontmatter.category} />
  </div>
</BaseLayout>
) : (<LegacyBlogLayout {...Astro.props}><slot /></LegacyBlogLayout>)}
