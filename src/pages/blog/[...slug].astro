---
import BlogPost from '@page-content/BlogPost.astro';
import { loadPlatformPost, refusal } from '@lib/blog-page';

// Resolved PER REQUEST from the Core, never built ahead of time: a prerendered
// page renders once with no request, so no tenant resolves and — worse — it
// would be served by the static handler BEFORE any middleware could gate it
// (the platform's blog under a client's domain). The middleware has already
// checked the address against the site's archive (D-7); this repeats the answer
// for a cache that moved in between, and never asks for another site's post.
const { slug } = Astro.params;
const loaded = await loadPlatformPost(Astro.locals.tenant.slug, 'en', slug);
if (!loaded.ok) return refusal(loaded.status);
---

<BlogPost post={loaded.post} rendered={loaded.rendered} locale="en" />
