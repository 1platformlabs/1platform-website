---
import BlogPost from '@page-content/BlogPost.astro';
import { postPaths } from '@i18n/collections';

// Built ahead of time, not per request: in server mode Astro IGNORES getStaticPaths
// unless the route says so, and Astro.props.post then arrives undefined — the
// render dies mid-stream with RenderUndefinedEntryError. Measured in F1.
// The blog belongs to tenant #1 (D-18); gating these by host is F4's job.
export const prerender = true;

export async function getStaticPaths() {
  return postPaths('es');
}

const { post } = Astro.props;
---

<BlogPost post={post} />
